<?xml version="1.0" encoding="utf-8" ?>
<!--
  ActionBar.xaml
  Extracted from MainPage.xaml — Phase 5 ContentView split.
  BindingContext is inherited from MainPage (MainViewModel).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CopyCat.ViewModels"
    xmlns:models="clr-namespace:CopyCat.Models"
    xmlns:behaviors="clr-namespace:CopyCat.Behaviors"
    x:Class="CopyCat.Views.Results.ActionBar"
    x:DataType="vm:MainViewModel"
    x:Name="Self">

    <ContentView.Content>
        <!-- ═══════════════════════════════════════════════════════════════
             SMART ACTION BAR
             ═══════════════════════════════════════════════════════════════ -->
        <Border Style="{StaticResource SmartActionBarBorder}" Padding="16,10,16,50">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                <!-- Busy row -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding Chunking.IsBusy}">
                    <ActivityIndicator Grid.Column="0" IsRunning="{Binding Chunking.IsBusy}"
                                       Color="{StaticResource AccentPrimary}"
                                       HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Chunking.StatusText}"
                           TextColor="{StaticResource TextSecondary}" FontSize="13"
                           VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                    <Button Grid.Column="2" Text="Abort" Style="{StaticResource SecondaryBtn}"
                            FontSize="13" MinimumHeightRequest="40" Command="{Binding Chunking.CancelCommand}"
                            ToolTipProperties.Text="Cancel the current fetch or chunking operation" />
                </Grid>

                <!-- Copy progress -->
                <Label Grid.Row="0" Text="{Binding Chunks.CopyProgressLabel}"
                       TextColor="{StaticResource AccentSecond}"
                       FontSize="12" FontFamily="OpenSansSemibold"
                       HorizontalOptions="Center"
                       IsVisible="{Binding Chunks.HasCopyProgress}"
                       Margin="0,2,0,0" />

                <!-- Config mode: Chunk button -->
                <Button Grid.Row="1"
                        ImageSource="copycat_logo.svg"
                        Style="{StaticResource PrimaryBtn}"
                        HeightRequest="90" ContentLayout="Top,0"
                        Command="{Binding Chunking.FetchCommand}"
                        IsVisible="{Binding Chunking.IsConfigurationMode}"
                        IsEnabled="{Binding Chunking.IsBusy, Converter={StaticResource InverseBool}}"
                        ToolTipProperties.Text="Fetch the repository and split into token-bounded chunks ready for pasting into an AI chat" />

                <!-- Results mode — no selection: Reset + Next + Edit Config -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="8"
                      IsVisible="{Binding Chunking.IsResultsAndNoSelection}">
                    <Button Grid.Column="0" Text="🔄  Reset"
                            Style="{StaticResource SecondaryBtn}"
                            Command="{Binding Chunking.ResetCommand}"
                            IsEnabled="{Binding Chunking.IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTipProperties.Text="Clear all results and return to configuration" />
                    <Button Grid.Column="1" Text="▶ Next"
                            Style="{StaticResource ChunkActionBtn}"
                            Command="{Binding Chunks.CopyNextChunkCommand}"
                            IsVisible="{Binding Chunks.HasChunks}"
                            IsEnabled="{Binding Chunking.IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTipProperties.Text="Copy the next un-copied chunk to clipboard and advance the progress counter" />
                    <Button Grid.Column="2" Text="⚙  Edit Config"
                            Style="{StaticResource BackBtn}"
                            Command="{Binding Chunking.BackToConfigurationCommand}"
                            IsEnabled="{Binding Chunking.IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTipProperties.Text="Return to configuration to adjust filters without clearing results" />
                </Grid>

                <!-- Selection toolbar -->
                <Border Grid.Row="1"
                        Style="{StaticResource SelectionToolbarBorder}"
                        IsVisible="{Binding Chunks.HasSelection}"
                        ZIndex="1">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding Chunks.ShareSelectedLabel}" Style="{StaticResource SelectionCountLabel}" />
                                <Label Text="{Binding Chunks.SelectedTokensLabel}" Style="{StaticResource SelectionTokensLabel}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="✕"
                                    Style="{StaticResource IconBtn}"
                                    Command="{Binding Chunks.ClearSelectionCommand}"
                                    ToolTipProperties.Text="Deselect all chunks" />
                            <Button Grid.Column="2" Text="⊕ Merge"
                                    Style="{StaticResource ToggleAllBtn}"
                                    Command="{Binding Chunks.MergeSelectedCommand}"
                                    IsVisible="{Binding Chunks.CanMerge}"
                                    ToolTipProperties.Text="Merge selected chunks into one combined chunk" />
                            <Button Grid.Column="3" Text="📋 Copy"
                                    Style="{StaticResource CopySelectedBtn}"
                                    Command="{Binding Chunks.CopySelectedCommand}"
                                    ToolTipProperties.Text="Copy all selected chunks (with active AI prompt) to clipboard" />
                            <Button Grid.Column="4" Text="↗ Share"
                                    Style="{StaticResource ShareBtn}"
                                    Command="{Binding Chunks.ShareSelectedCommand}"
                                    ToolTipProperties.Text="Open the system share sheet to send selected chunks to another app" />
                        </Grid>
                        <Label Grid.Row="1"
                               Text="{Binding Chunks.SelectionWarningLabel}"
                               TextColor="{Binding Chunks.SelectionWarningColor}"
                               Style="{StaticResource SelectionWarningLabelStyle}"
                               IsVisible="{Binding Chunks.HasSelectionWarning}" />
                    </Grid>
                </Border>

            </Grid>
        </Border>

    </ContentView.Content>

</ContentView>
