<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CopyCat.ViewModels"
    xmlns:models="clr-namespace:CopyCat.Models"
    xmlns:behaviors="clr-namespace:CopyCat.Behaviors"
    x:Class="CopyCat.Views.Results.ChunkListView"
    x:DataType="vm:ChunkListViewModel"
    x:Name="Self">

    <ContentView.Content>

        <VerticalStackLayout IsVisible="{Binding HasChunks}" Spacing="0">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <Label Grid.Column="0" Text="CHUNKS" Style="{StaticResource SectionTitle}"
                       Margin="0" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="{Binding SelectAllChunksLabel}"
                        Style="{StaticResource ToggleAllBtn}"
                        Command="{Binding SelectAllChunksCommand}"
                        ToolTipProperties.Text="Select all chunks to copy or share multiple at once." />
                <Label Grid.Column="2"
                       Text="{Binding HasSelection, Converter={StaticResource SelectionHintConv}}"
                       TextColor="{StaticResource TextMuted}" FontSize="11" VerticalOptions="Center" />
            </Grid>

            <!-- Search bar -->
            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Grid.Column="0" Style="{StaticResource InputEntry}"
                           Text="{Binding ChunkSearchText}"
                           Placeholder="Search chunk titles and content…" Margin="4,0,0,0" />
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Text="✕"
                            Command="{Binding ClearChunkSearchCommand}"
                            IsVisible="{Binding ChunkSearchText, Converter={StaticResource StringNotEmptyConv}}"
                            ToolTipProperties.Text="Clear search filter" />
                </Grid>
            </Border>

            <Label Text="{Binding ChunkSearchSummary}"
                   TextColor="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6"
                   IsVisible="{Binding ChunkSearchText, Converter={StaticResource StringNotEmptyConv}}" />

            <!-- ══ Quick Prompt ephemeral card ═══════════════════════════════════ -->
            <Border Style="{StaticResource ChunkBorder}"
                    Stroke="{Binding QuickPromptBorderColor}"
                    StrokeThickness="0.8" Margin="0,0,0,4">
                <VerticalStackLayout Spacing="0">

                    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,90">

                        <!-- ZONE A: tap to select -->
                        <Grid Grid.Row="0" Grid.Column="0"
                              BackgroundColor="{Binding QuickPromptZoneA}"
                              Padding="12,8">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="6">
                                    <Border Style="{StaticResource SelectionDot}"
                                            BackgroundColor="{Binding IsQuickPromptSelected, Converter={StaticResource SelectionDotBgConv}}"
                                            Stroke="{Binding IsQuickPromptSelected, Converter={StaticResource SelectionDotBorderConv}}"
                                            VerticalOptions="Center">
                                        <Label Style="{StaticResource SelectionDotCheck}"
                                               IsVisible="{Binding IsQuickPromptSelected}" />
                                    </Border>
                                    <Label Text="QUICK PROMPT" Style="{StaticResource SectionTitle}"
                                           Margin="0" VerticalOptions="Center" />
                                    <Label Text="— not saved" TextColor="{StaticResource TextDim}"
                                           FontSize="11" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding QuickPromptText}"
                                       TextColor="{StaticResource TextSecondary}" FontSize="12"
                                       LineBreakMode="TailTruncation" MaxLines="2" Margin="28,0,0,0"
                                       IsVisible="{Binding IsQuickPromptExpanded, Converter={StaticResource InverseBool}}" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleQuickPromptSelectionCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <BoxView Grid.Row="0" Grid.Column="0" HorizontalOptions="End"
                                 Style="{StaticResource CardZoneSeparatorView}" />

                        <!-- ZONE B: Copy + Clear -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                             VerticalOptions="Center" HorizontalOptions="Center"
                                             Spacing="4" Padding="0,8">
                            <Border Style="{StaticResource CopiedBadgeBorder}"
                                    IsVisible="{Binding IsQuickPromptCopied}"
                                    HorizontalOptions="Center">
                                <Label Style="{StaticResource CopiedBadgeLabel}" />
                            </Border>
                            <Button Text="Copy" Style="{StaticResource ChunkActionBtn}"
                                    MinimumWidthRequest="68"
                                    Command="{Binding CopyQuickPromptCommand}"
                                    IsEnabled="{Binding HasQuickPromptText}"
                                    ToolTipProperties.Text="Copy quick prompt text to clipboard" />
                            <Button Text="✕" Style="{StaticResource SmallIconBtn}"
                                    HorizontalOptions="Center"
                                    Command="{Binding ClearQuickPromptCommand}"
                                    IsVisible="{Binding HasQuickPromptText}"
                                    ToolTipProperties.Text="Clear quick prompt" />
                        </VerticalStackLayout>

                        <!-- ZONE C: expand -->
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                Style="{StaticResource CardZoneCBorder}">
                            <Grid ColumnDefinitions="*" HeightRequest="36">
                                <Label Text="{Binding QuickPromptExpandIcon}"
                                       TextColor="{StaticResource TextMuted}" FontSize="11"
                                       VerticalOptions="Center" HorizontalTextAlignment="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleQuickPromptExpandCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Expanded editor -->
                    <Border IsVisible="{Binding IsQuickPromptExpanded}"
                            BackgroundColor="#0A0A14" StrokeThickness="0" Padding="12,8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Type your prompt below — never saved to the library."
                                   TextColor="{StaticResource TextDim}" FontSize="11" LineBreakMode="WordWrap" />
                            <Border Style="{StaticResource InputBorder}">
                                <Editor Text="{Binding QuickPromptText}"
                                        Placeholder="e.g. Summarise this code in plain English…"
                                        AutoSize="TextChanges" MinimumHeightRequest="80"
                                        Style="{StaticResource InputEntry}" FontSize="13" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- ══ Chunk cards ═══════════════════════════════════════════════════ -->
            <VerticalStackLayout Spacing="0">
                <BindableLayout.ItemsSource>
                    <Binding Path="FilteredChunks" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:CodeChunk">

                        <Border Style="{StaticResource ChunkBorder}"
                                Stroke="{Binding CardBorderColor}"
                                StrokeThickness="{Binding CardBorderThickness}">
                            <Border.Behaviors>
                                <behaviors:TactileCopyBehavior />
                            </Border.Behaviors>

                            <VerticalStackLayout Spacing="0">

                                <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,90">

                                    <!-- ZONE A: select -->
                                    <Grid Grid.Row="0" Grid.Column="0"
                                          BackgroundColor="{Binding ZoneABackground}"
                                          Padding="14,12,10,12">
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                    Style="{StaticResource SelectionDot}"
                                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectionDotBgConv}}"
                                                    Stroke="{Binding IsSelected, Converter={StaticResource SelectionDotBorderConv}}"
                                                    VerticalOptions="Center">
                                                <Label Style="{StaticResource SelectionDotCheck}"
                                                       IsVisible="{Binding IsSelected}" />
                                            </Border>
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding DisplayLabel}"
                                                   Style="{StaticResource ChunkTitleLabel}" />
                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="0">
                                                <Label Text="{Binding SubLabel}" Style="{StaticResource ChunkSubLabel}" />
                                                <Label Text="{Binding ChunkWarningIcon}"
                                                       Style="{StaticResource ChunkWarningLabelStyle}"
                                                       IsVisible="{Binding ChunkWarningIcon, Converter={StaticResource StringNotEmptyConv}}"
                                                       ToolTipProperties.Text="⛔ &gt;128K&#10;⚠️ &gt;32K&#10;ℹ️ &gt;16K" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Self}, Path=BindingContext.ToggleChunkSelectionCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <BoxView Grid.Row="0" Grid.Column="0" HorizontalOptions="End"
                                             Style="{StaticResource CardZoneSeparatorView}" />

                                    <!-- ZONE B: copy -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                         VerticalOptions="Center" HorizontalOptions="Center"
                                                         Spacing="4" Padding="0,8">
                                        <Border Style="{StaticResource CopiedBadgeBorder}"
                                                IsVisible="{Binding IsCopied}" HorizontalOptions="Center">
                                            <Label Style="{StaticResource CopiedBadgeLabel}" />
                                        </Border>
                                        <Button Text="Copy" Style="{StaticResource ChunkActionBtn}"
                                                MinimumWidthRequest="68"
                                                Command="{Binding Source={x:Reference Self}, Path=BindingContext.CopyChunkCommand}"
                                                CommandParameter="{Binding .}"
                                                ToolTipProperties.Text="Copy this chunk to clipboard" />
                                    </VerticalStackLayout>

                                    <!-- ZONE C: expand strip -->
                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Style="{StaticResource CardZoneCBorder}">
                                        <Grid ColumnDefinitions="*,Auto" HeightRequest="36">
                                            <Label Grid.Column="0"
                                                   Text="{Binding PreviewToggleIcon}"
                                                   TextColor="{StaticResource TextMuted}" FontSize="11"
                                                   VerticalOptions="Center" HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding SubLabel}"
                                                   TextColor="{StaticResource TextDim}" FontSize="10"
                                                   VerticalOptions="Center" Margin="0,0,14,0" />
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Self}, Path=BindingContext.TogglePreviewCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Expanded file list -->
                                <VerticalStackLayout IsVisible="{Binding IsPreviewExpanded}" Spacing="0">

                                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="12,6,8,2">
                                        <Label Grid.Column="0" Text="FILES IN THIS CHUNK"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="✓ All"
                                                Style="{StaticResource SmallIconBtn}"
                                                TextColor="{StaticResource AccentSecond}"
                                                Command="{Binding Source={x:Reference Self}, Path=BindingContext.IncludeAllChunkFilesCommand}"
                                                CommandParameter="{Binding .}"
                                                ToolTipProperties.Text="Include all files in this chunk when copying" />
                                        <Button Grid.Column="2" Text="✕ All"
                                                Style="{StaticResource SmallIconBtn}"
                                                TextColor="{StaticResource TextError}"
                                                Command="{Binding Source={x:Reference Self}, Path=BindingContext.ExcludeAllChunkFilesCommand}"
                                                CommandParameter="{Binding .}"
                                                ToolTipProperties.Text="Exclude all files from this chunk" />
                                    </Grid>

                                    <VerticalStackLayout Spacing="0">
                                        <BindableLayout.ItemsSource>
                                            <Binding Path="FileEntries" />
                                        </BindableLayout.ItemsSource>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChunkFile">
                                                <VerticalStackLayout Spacing="0">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,6"
                                                          BackgroundColor="{Binding RowBackground}">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding ExcludeIcon}"
                                                               TextColor="{Binding ExcludeIconColor}"
                                                               FontSize="13" VerticalOptions="Center" Margin="0,0,8,0"
                                                               ToolTipProperties.Text="Tap to include or exclude this file">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference Self}, Path=BindingContext.ToggleFileEntryExclusionCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                        <Label Grid.Column="1" Text="{Binding FileName}"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               FontSize="12" FontFamily="OpenSansSemibold"
                                                               VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference Self}, Path=BindingContext.ToggleFileCodeCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                        <Label Grid.Column="2" Text="{Binding ExpandIcon}"
                                                               TextColor="{StaticResource TextMuted}"
                                                               FontSize="11" VerticalOptions="Center" Margin="0,0,4,0"
                                                               ToolTipProperties.Text="Tap to show/hide source code">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference Self}, Path=BindingContext.ToggleFileCodeCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>
                                                    <ScrollView IsVisible="{Binding IsCodeExpanded}"
                                                                Orientation="Horizontal" HeightRequest="240"
                                                                BackgroundColor="{StaticResource BgApp}">
                                                        <Label Text="{Binding Content}"
                                                               FontFamily="Courier New" FontSize="11"
                                                               TextColor="{StaticResource TextMuted}"
                                                               LineBreakMode="NoWrap" Padding="14,8" />
                                                    </ScrollView>
                                                    <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" Opacity="0.4" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>

    </ContentView.Content>

</ContentView>