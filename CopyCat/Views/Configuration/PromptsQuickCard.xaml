<?xml version="1.0" encoding="utf-8" ?>
<!--
  PromptsQuickCard.xaml
  Extracted from MainPage.xaml — Phase 5 ContentView split.
  BindingContext is inherited from MainPage (MainViewModel).
  Commands inside DataTemplates bind via {x:Reference Self} which
  resolves to this ContentView, then .BindingContext.XxxCommand.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CopyCat.ViewModels"
    xmlns:models="clr-namespace:CopyCat.Models"
    xmlns:behaviors="clr-namespace:CopyCat.Behaviors"
    x:Class="CopyCat.Views.Configuration.PromptsQuickCard"
    x:DataType="vm:MainViewModel"
    x:Name="Self">

    <ContentView.Content>
                    <!-- ── AI PROMPTS — compact card (full management on PromptsPage) ── -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                <Label Text="AI PROMPT" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                <Label Text="{Binding Prompts.SelectedPromptLabel}"
                                       TextColor="{StaticResource AccentSecond}"
                                       FontSize="12" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="⚙ Manage Prompts"
                                    Style="{StaticResource ToggleAllBtn}"
                                    Command="{Binding Prompts.NavigateToPromptsPageCommand}"
                                    ToolTipProperties.Text="Open the AI Prompt Library — select, edit or create prompts that are prepended to every chunk you copy" />
                        </Grid>
                    </Border>

    </ContentView.Content>

</ContentView>
