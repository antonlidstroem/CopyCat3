<?xml version="1.0" encoding="utf-8" ?>
<!--
  PromptsPage.xaml
  ────────────────────────────────────────────────────────────────────
  ITEM 5: Prompt card Zone B now uses ChunkActionBtn + CopiedBadge,
          matching the chunk card copy-button design exactly.
          Selection dot in Zone A mirrors chunk card selection dot.

  ITEM 7: Edit panel has an optional guided builder panel injected
          between the title field and the content editor.
          The builder panel is shown/hidden via a toggle button.
          Selecting roles + output format generates XML into EditContent.
          Free-text editing still works as before.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CopyCat.ViewModels"
             xmlns:models="clr-namespace:CopyCat.Models"
             x:Class="CopyCat.Views.PromptsPage"
             x:DataType="vm:MainViewModel"
             x:Name="PromptsPageRef"
             Title="AI Prompts"
             BackgroundColor="{StaticResource BgApp}">

    <Grid RowDefinitions="*,Auto">

        <!-- ═════════════════════════ SCROLLABLE CONTENT ═════════════════════ -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Padding="14,14,14,8" Spacing="0">

                <!-- Active prompt banner -->
                <Border BackgroundColor="{StaticResource AccentSecondBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource AccentSecondBorder}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,10" Margin="0,0,0,10"
                        IsVisible="{Binding Prompts.HasSelectedPrompt}">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="✓" TextColor="{StaticResource AccentSecond}"
                               FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                            <Label Text="ACTIVE PROMPT" Style="{StaticResource SectionTitle}"
                                   Margin="0" TextColor="{StaticResource AccentSecond}" />
                            <Label Text="{Binding Prompts.SelectedPromptLabel}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13" FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <Label Text="Tap the left zone of any card to select it as your active prompt. Copy it first, then copy your chunks one by one."
                       Style="{StaticResource HintLabel}"
                       Margin="0,0,0,10"
                       IsVisible="{Binding Prompts.HasSelectedPrompt, Converter={StaticResource InverseBool}}" />

                <!-- ══ PROMPT CARDS ════════════════════════════════════════════ -->
                <VerticalStackLayout Spacing="0">
                    <BindableLayout.ItemsSource>
                        <Binding Path="Prompts.Prompts" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PromptItem">

                            <!-- ── Card border: teal when selected, amber when modified ── -->
                            <Border Style="{StaticResource ChunkBorder}"
                                    Stroke="{Binding IsSelectedForShare, Converter={StaticResource PromptBorderConv}}"
                                    StrokeThickness="{Binding CardBorderThickness}">
                                <VerticalStackLayout Spacing="0">

                                    <!-- Three-zone grid -->
                                    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,90">

                                        <!-- ZONE A — Select (tap = toggle IsSelectedForShare) -->
                                        <Grid Grid.Row="0" Grid.Column="0"
                                              BackgroundColor="{Binding ZoneABackground}"
                                              Padding="14,12,10,12">
                                            <!-- ITEM 5: selection dot matches chunk card dot -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Border Grid.Column="0"
                                                        Style="{StaticResource SelectionDot}"
                                                        BackgroundColor="{Binding IsSelectedForShare, Converter={StaticResource SelectionDotBgConv}}"
                                                        Stroke="{Binding IsSelectedForShare, Converter={StaticResource SelectionDotBorderConv}}"
                                                        VerticalOptions="Center">
                                                    <Label Style="{StaticResource SelectionDotCheck}"
                                                           IsVisible="{Binding IsSelectedForShare}" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" Style="{StaticResource ChunkTitleLabel}" />
                                                    <Label Text="{Binding PreviewText}"
                                                           TextColor="{StaticResource TextMuted}"
                                                           FontSize="12"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2"
                                                           IsVisible="{Binding IsEditing, Converter={StaticResource InverseBool}}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.SelectPromptForShareCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <!-- Zone A/B separator -->
                                        <BoxView Grid.Row="0" Grid.Column="0"
                                                 HorizontalOptions="End"
                                                 Style="{StaticResource CardZoneSeparatorView}" />

                                        <!-- ZONE B — ITEM 5: CopiedBadge + ChunkActionBtn + edit/reset -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                             Spacing="4" VerticalOptions="Center"
                                                             HorizontalOptions="Center"
                                                             Padding="0,8">
                                            <!-- Copied badge — same as chunk card -->
                                            <Border Style="{StaticResource CopiedBadgeBorder}"
                                                    IsVisible="{Binding IsCopied}"
                                                    HorizontalOptions="Center">
                                                <Label Style="{StaticResource CopiedBadgeLabel}" />
                                            </Border>
                                            <!-- Copy — ChunkActionBtn style -->
                                            <Button Text="Copy"
                                                    Style="{StaticResource ChunkActionBtn}"
                                                    MinimumWidthRequest="68"
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.CopyPromptCommand}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTipProperties.Text="Copy prompt text to clipboard" />
                                            <!-- Edit -->
                                            <Button Style="{StaticResource SmallIconBtn}" Text="✎"
                                                    IsVisible="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.StartEditPromptCommand}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTipProperties.Text="Edit title and content" />
                                            <!-- Reset (built-ins only) -->
                                            <Button Style="{StaticResource SmallIconBtn}" Text="↺"
                                                    IsVisible="{Binding IsBuiltIn}"
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.ResetSinglePromptCommand}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTipProperties.Text="Restore to factory default text" />
                                        </VerticalStackLayout>

                                        <!-- ZONE C — Expand strip -->
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Style="{StaticResource CardZoneCBorder}">
                                            <Grid ColumnDefinitions="*,Auto" HeightRequest="36">
                                                <Label Grid.Column="0"
                                                       Text="{Binding PreviewToggleIcon}"
                                                       TextColor="{StaticResource TextMuted}"
                                                       FontSize="11" VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Grid.Column="1"
                                                       Text="Full text"
                                                       TextColor="{StaticResource TextDim}"
                                                       FontSize="10" VerticalOptions="Center"
                                                       Margin="0,0,14,0" />
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.TogglePromptPreviewCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Full text preview panel -->
                                    <Border IsVisible="{Binding IsPreviewExpanded}"
                                            BackgroundColor="{StaticResource BgPreview}"
                                            StrokeThickness="0" Padding="12,8,12,12">
                                        <Label Text="{Binding Content}" Style="{StaticResource PromptPreviewLabel}" />
                                    </Border>

                                    <!-- ══ Edit panel (IsEditing = true) ═══════════════════════════ -->
                                    <Border Style="{StaticResource PromptEditBorder}"
                                            IsVisible="{Binding IsEditing}">
                                        <VerticalStackLayout Spacing="8">

                                            <!-- Title field -->
                                            <Border Style="{StaticResource InputBorder}">
                                                <Entry Style="{StaticResource InputEntry}"
                                                       Text="{Binding EditTitle}"
                                                       Placeholder="Prompt title…" />
                                            </Border>

                                            <!--
                                                ITEM 7: Guided builder toggle button.
                                                The builder panel lives on PromptsViewModel.Builder.
                                                It is only shown when Builder is not null (set in StartEditPrompt).
                                            -->
                                            <Button Text="🧩 Build with guided roles (optional)"
                                                    Style="{StaticResource SmallIconBtn}"
                                                    HorizontalOptions="Start"
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.ToggleBuilderCommand}"
                                                    IsVisible="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.HasBuilder}"
                                                    ToolTipProperties.Text="Open the role selector to build a structured multi-role prompt. Optional — you can still write freehand below." />

                                            <!-- ITEM 7: Builder panel — shown when builder is visible -->
                                            <Border BackgroundColor="#0A0A18"
                                                    Stroke="#2D2D50"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="12,10"
                                                    IsVisible="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.IsBuilderVisible}">
                                                <VerticalStackLayout Spacing="10">

                                                    <!-- Role chips header -->
                                                    <Label Text="SELECT ROLES"
                                                           Style="{StaticResource SectionTitle}"
                                                           Margin="0" />
                                                    <Label Text="Each selected role becomes an XML-tagged section instructing the AI to analyse from that perspective."
                                                           TextColor="{StaticResource TextMuted}"
                                                           FontSize="11"
                                                           LineBreakMode="WordWrap" />

                                                    <!-- Role chip grid -->
                                                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                                                        <BindableLayout.ItemsSource>
                                                            <Binding Source="{x:Reference PromptsPageRef}"
                                                                     Path="BindingContext.Prompts.Builder.Roles" />
                                                        </BindableLayout.ItemsSource>
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:RoleSelectionItem">
                                                                <Border Style="{StaticResource ChipBorder}"
                                                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource ChipIncludedBgConv}}"
                                                                        Stroke="{Binding IsSelected, Converter={StaticResource ChipIncludedBorderConv}}"
                                                                        Margin="0,0,4,4">
                                                                    <VerticalStackLayout Spacing="1" Padding="2,0">
                                                                        <Label Text="{Binding ChipLabel}"
                                                                               Style="{StaticResource ChipLabel}"
                                                                               TextColor="{Binding IsSelected, Converter={StaticResource ChipLabelColorConv}}" />
                                                                        <Label Text="{Binding Description}"
                                                                               TextColor="{StaticResource TextDim}"
                                                                               FontSize="10"
                                                                               LineBreakMode="TailTruncation"
                                                                               MaxLines="1" />
                                                                    </VerticalStackLayout>
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.ToggleRoleCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Border.GestureRecognizers>
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>

                                                    <!-- Output format header -->
                                                    <Label Text="OUTPUT FORMAT"
                                                           Style="{StaticResource SectionTitle}"
                                                           Margin="0,4,0,0" />

                                                    <!-- Format option rows -->
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                                          ColumnSpacing="10" RowSpacing="6">

                                                        <!-- Free text -->
                                                        <Border Grid.Row="0" Grid.Column="0"
                                                                WidthRequest="16" HeightRequest="16"
                                                                StrokeShape="Ellipse"
                                                                Stroke="{StaticResource AccentPrimary}"
                                                                BackgroundColor="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectedOutputFormatId,
                                                                    Converter={StaticResource StringNotEmptyConv}}"
                                                                VerticalOptions="Center">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectOutputFormatCommand}"
                                                                    CommandParameter="free" />
                                                            </Border.GestureRecognizers>
                                                        </Border>
                                                        <Label Grid.Row="0" Grid.Column="1"
                                                               Text="Free text (default)"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               FontSize="12" VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectOutputFormatCommand}"
                                                                    CommandParameter="free" />
                                                            </Label.GestureRecognizers>
                                                        </Label>

                                                        <!-- Numbered list -->
                                                        <Border Grid.Row="1" Grid.Column="0"
                                                                WidthRequest="16" HeightRequest="16"
                                                                StrokeShape="Ellipse"
                                                                Stroke="{StaticResource AccentPrimary}"
                                                                VerticalOptions="Center">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectOutputFormatCommand}"
                                                                    CommandParameter="list" />
                                                            </Border.GestureRecognizers>
                                                        </Border>
                                                        <Label Grid.Row="1" Grid.Column="1"
                                                               Text="Numbered list"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               FontSize="12" VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectOutputFormatCommand}"
                                                                    CommandParameter="list" />
                                                            </Label.GestureRecognizers>
                                                        </Label>

                                                        <!-- Markdown table -->
                                                        <Border Grid.Row="2" Grid.Column="0"
                                                                WidthRequest="16" HeightRequest="16"
                                                                StrokeShape="Ellipse"
                                                                Stroke="{StaticResource AccentPrimary}"
                                                                VerticalOptions="Center">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectOutputFormatCommand}"
                                                                    CommandParameter="table" />
                                                            </Border.GestureRecognizers>
                                                        </Border>
                                                        <Label Grid.Row="2" Grid.Column="1"
                                                               Text="Markdown table"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               FontSize="12" VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectOutputFormatCommand}"
                                                                    CommandParameter="table" />
                                                            </Label.GestureRecognizers>
                                                        </Label>

                                                        <!-- Structured XML output -->
                                                        <Border Grid.Row="3" Grid.Column="0"
                                                                WidthRequest="16" HeightRequest="16"
                                                                StrokeShape="Ellipse"
                                                                Stroke="{StaticResource AccentPrimary}"
                                                                VerticalOptions="Center">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectOutputFormatCommand}"
                                                                    CommandParameter="xml_out" />
                                                            </Border.GestureRecognizers>
                                                        </Border>
                                                        <Label Grid.Row="3" Grid.Column="1"
                                                               Text="Structured XML output"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               FontSize="12" VerticalOptions="Center">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.SelectOutputFormatCommand}"
                                                                    CommandParameter="xml_out" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>

                                                    <!-- XML skeleton preview (live preview of assembled structure) -->
                                                    <VerticalStackLayout
                                                        IsVisible="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.HasSelectedRoles}"
                                                        Spacing="4">
                                                        <Label Text="PROMPT SKELETON PREVIEW"
                                                               Style="{StaticResource SectionTitle}"
                                                               Margin="0,4,0,0" />
                                                        <Label Text="This is the XML structure that will be inserted into your prompt. You can edit the full text below after applying."
                                                               TextColor="{StaticResource TextMuted}"
                                                               FontSize="11"
                                                               LineBreakMode="WordWrap" />
                                                        <Border BackgroundColor="#060610"
                                                                Stroke="#1E1E3A"
                                                                StrokeThickness="1"
                                                                StrokeShape="RoundRectangle 6"
                                                                Padding="10,8">
                                                            <Label Text="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.XmlSkeletonPreview}"
                                                                   FontFamily="Courier New"
                                                                   FontSize="11"
                                                                   TextColor="{StaticResource AccentPrimary}"
                                                                   LineBreakMode="WordWrap" />
                                                        </Border>
                                                    </VerticalStackLayout>

                                                    <!-- Apply and Reset builder buttons -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Button Grid.Column="0"
                                                                Text="→ Apply to prompt text"
                                                                Style="{StaticResource SecondaryBtn}"
                                                                Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.ApplyBuilderToEditContentCommand}"
                                                                CommandParameter="{Binding .}"
                                                                IsEnabled="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.HasSelectedRoles}"
                                                                ToolTipProperties.Text="Insert the assembled XML skeleton into the prompt text editor below. You can edit freely afterwards." />
                                                        <Button Grid.Column="1"
                                                                Text="↺ Reset"
                                                                Style="{StaticResource SmallIconBtn}"
                                                                Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.Builder.ResetBuilderCommand}"
                                                                ToolTipProperties.Text="Clear all role selections and reset output format" />
                                                    </Grid>

                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Content editor — always visible when editing -->
                                            <Label Text="PROMPT TEXT"
                                                   Style="{StaticResource SectionTitle}"
                                                   Margin="0,4,0,2" />
                                            <Label Text="Use [PASTE CHUNK] as a placeholder for the code. If omitted, code is appended at the end."
                                                   TextColor="{StaticResource TextMuted}"
                                                   FontSize="11"
                                                   LineBreakMode="WordWrap"
                                                   Margin="0,0,0,4" />
                                            <Border Style="{StaticResource InputBorder}">
                                                <Editor Style="{StaticResource InlineEditor}"
                                                        Text="{Binding EditContent}"
                                                        Placeholder="Prompt text… or tap 'Apply' above to insert the XML skeleton." />
                                            </Border>

                                            <!-- Save / Cancel / Delete row -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Button Grid.Column="0" Style="{StaticResource SmallIconBtn}"
                                                        Text="🗑 Delete"
                                                        IsVisible="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.DeletePromptCommand}"
                                                        CommandParameter="{Binding .}"
                                                        TextColor="{StaticResource TextError}"
                                                        ToolTipProperties.Text="Permanently delete this custom prompt" />
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Text="Save"
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.SavePromptCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Grid.Column="2" Style="{StaticResource SmallIconBtn}" Text="Cancel"
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.Prompts.CancelEditPromptCommand}"
                                                        CommandParameter="{Binding .}"
                                                        TextColor="{StaticResource TextSecondary}" />
                                            </Grid>

                                        </VerticalStackLayout>
                                    </Border>
                                    <!-- ══ End edit panel ══════════════════════════════════════════ -->

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Add new prompt + Reset all -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,24">
                    <Button Grid.Column="0" Text="+ New prompt"
                            Style="{StaticResource SecondaryBtn}"
                            Command="{Binding Prompts.AddNewPromptCommand}"
                            ToolTipProperties.Text="Create a new custom AI prompt" />
                    <Button Grid.Column="1" Text="↺ Reset all"
                            Style="{StaticResource ResetPromptsBtn}"
                            x:Name="ResetPromptsButton"
                            ToolTipProperties.Text="Delete all custom prompts and restore the built-in defaults" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═════════════════════════ BOTTOM DONE BAR ════════════════════════ -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BgSmartBar}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderDefault}"
                Padding="16,10,16,44">
            <Button Text="← Done — return to chunking"
                    Style="{StaticResource SecondaryBtn}"
                    Command="{Binding Prompts.GoBackCommand}"
                    ToolTipProperties.Text="Return to the main view. Your prompt selection is remembered." />
        </Border>

    </Grid>
</ContentPage>
