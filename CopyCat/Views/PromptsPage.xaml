<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CopyCat.ViewModels"
             xmlns:models="clr-namespace:CopyCat.Models"
             x:Class="CopyCat.Views.PromptsPage"
             x:DataType="vm:MainViewModel"
             x:Name="PromptsPageRef"
             Title="AI Prompts"
             BackgroundColor="{StaticResource BgApp}">

    <Grid RowDefinitions="*,Auto">

        <!-- ═══════════════════════════════════════ SCROLLABLE CONTENT -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Padding="14,14,14,8" Spacing="0">

                <!-- Active prompt banner -->
                <Border BackgroundColor="{StaticResource AccentSecondBg}"
                        StrokeThickness="1"
                        Stroke="{StaticResource AccentSecondBorder}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,10"
                        Margin="0,0,0,10"
                        IsVisible="{Binding HasSelectedPrompt}">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="✓" TextColor="{StaticResource AccentSecond}"
                               FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                            <Label Text="ACTIVE PROMPT" Style="{StaticResource SectionTitle}"
                                   Margin="0" TextColor="{StaticResource AccentSecond}" />
                            <Label Text="{Binding SelectedPromptLabel}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="13" FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Hint when no prompt selected -->
                <Label Text="Tap the left zone of any prompt card to select it. The selected prompt is automatically prepended when you copy or share chunks."
                       Style="{StaticResource HintLabel}"
                       Margin="0,0,0,10"
                       IsVisible="{Binding HasSelectedPrompt, Converter={StaticResource InverseBool}}" />

                <!-- ══ PROMPT CARDS — BindableLayout -->
                <VerticalStackLayout Spacing="0">
                    <BindableLayout.ItemsSource>
                        <Binding Path="Prompts" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PromptItem">

                            <!--
                                FIX B-1: CardBorderColor returns Color; Stroke is Brush.
                                ColorToBrushConverter wraps Color → SolidColorBrush so the
                                amber (modified) and teal (copied) borders actually render.
                            -->
                            <Border Style="{StaticResource PromptCardBorder}"
                                    Stroke="{Binding CardBorderColor, Converter={StaticResource ColorToBrushConv}}"
                                    StrokeThickness="{Binding CardBorderThickness}">
                                <VerticalStackLayout Spacing="0">

                                    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,90">

                                        <!-- ZONE A — Select -->
                                        <Grid Grid.Row="0" Grid.Column="0"
                                              BackgroundColor="{Binding ZoneABackground}"
                                              Padding="12,10">
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" Style="{StaticResource PromptTitleLabel}" />
                                                <Label Text="{Binding PreviewText}"
                                                       Style="{StaticResource PromptPreviewLabel2}"
                                                       IsVisible="{Binding IsEditing, Converter={StaticResource InverseBool}}" />
                                            </VerticalStackLayout>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.SelectPromptForShareCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <BoxView Grid.Row="0" Grid.Column="0"
                                                 HorizontalOptions="End"
                                                 Style="{StaticResource CardZoneSeparatorView}" />

                                        <!-- ZONE B — Copy/Edit/Reset -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                             Spacing="4" VerticalOptions="Center"
                                                             HorizontalOptions="Center"
                                                             Padding="0,8">
                                            <Button Style="{StaticResource SmallIconBtn}" Text="📋"
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.CopyPromptCommand}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTipProperties.Text="Copy prompt text to clipboard" />
                                            <Button Style="{StaticResource SmallIconBtn}" Text="✎"
                                                    IsVisible="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.StartEditPromptCommand}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTipProperties.Text="Edit this prompt's title and content" />
                                            <Button Style="{StaticResource SmallIconBtn}" Text="↺"
                                                    IsVisible="{Binding IsBuiltIn}"
                                                    Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.ResetSinglePromptCommand}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTipProperties.Text="Restore this built-in prompt to its factory default text" />
                                        </VerticalStackLayout>

                                        <!-- ZONE C — Expand strip -->
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Style="{StaticResource CardZoneCBorder}">
                                            <Grid ColumnDefinitions="*,Auto" HeightRequest="36">
                                                <Label Grid.Column="0"
                                                       Text="{Binding PreviewToggleIcon}"
                                                       TextColor="{StaticResource TextMuted}"
                                                       FontSize="11" VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center"
                                                       ToolTipProperties.Text="Expand to read the full prompt text" />
                                                <Label Grid.Column="1"
                                                       Text="Full text"
                                                       TextColor="{StaticResource TextDim}"
                                                       FontSize="10" VerticalOptions="Center"
                                                       Margin="0,0,14,0" />
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.TogglePromptPreviewCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Full text preview panel -->
                                    <Border IsVisible="{Binding IsPreviewExpanded}"
                                            BackgroundColor="{StaticResource BgPreview}"
                                            StrokeThickness="0" Padding="12,8,12,12">
                                        <Label Text="{Binding Content}" Style="{StaticResource PromptPreviewLabel}" />
                                    </Border>

                                    <!-- ═══ Edit panel ═══════════════════════════════════════════════
                                         Phase 4: Added Freehand / Builder mode toggle above the editor.
                                         When IsBuilderMode is true, the XML tag palette is shown so
                                         the user can append structured XML snippets to EditContent.
                                         Freehand editing remains possible at all times — the builder
                                         only appends to the existing editor content.
                                    -->
                                    <Border Style="{StaticResource PromptEditBorder}"
                                            IsVisible="{Binding IsEditing}">
                                        <VerticalStackLayout Spacing="8">

                                            <!-- Title field -->
                                            <Border Style="{StaticResource InputBorder}">
                                                <Entry Style="{StaticResource InputEntry}"
                                                       Text="{Binding EditTitle}"
                                                       Placeholder="Prompt title…" />
                                            </Border>

                                            <!-- Mode toggle: Freehand | Builder -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                                <Button Grid.Column="0"
                                                        Text="✏️ Freehand"
                                                        BackgroundColor="{Binding IsBuilderMode, Converter={StaticResource InverseBuildModeActiveBgConv}}"
                                                        TextColor="{Binding IsBuilderMode, Converter={StaticResource InverseBuildModeActiveTextConv}}"
                                                        FontSize="12" CornerRadius="8"
                                                        MinimumHeightRequest="34"
                                                        BorderWidth="1"
                                                        BorderColor="{Binding IsBuilderMode, Converter={StaticResource InverseBuildModeActiveBorderConv}}"
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.ToggleBuilderModeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        ToolTipProperties.Text="Switch to freehand text editing. The editor is always editable." />
                                                <Button Grid.Column="1"
                                                        Text="🧱 XML Builder"
                                                        BackgroundColor="{Binding IsBuilderMode, Converter={StaticResource BuilderModeActiveBgConv}}"
                                                        TextColor="{Binding IsBuilderMode, Converter={StaticResource BuilderModeActiveTextConv}}"
                                                        FontSize="12" CornerRadius="8"
                                                        MinimumHeightRequest="34"
                                                        BorderWidth="1"
                                                        BorderColor="{Binding IsBuilderMode, Converter={StaticResource BuilderModeActiveBorderConv}}"
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.ToggleBuilderModeCommand}"
                                                        CommandParameter="{Binding .}"
                                                        ToolTipProperties.Text="Show the XML tag button palette. Tapping a tag appends an XML snippet to the prompt." />
                                            </Grid>

                                            <!-- ══ XML Builder palette (Phase 4) ══════════════════════
                                                 Shown when IsBuilderMode=true.
                                                 Each button appends its tag pair + placeholder to EditContent.
                                                 Built-in tags use teal style; custom tags use amber style.
                                                 The "+ Custom tag" button triggers a dialog via event.
                                            -->
                                            <Border Style="{StaticResource BuilderPaletteBorder}"
                                                    IsVisible="{Binding IsBuilderMode}">
                                                <VerticalStackLayout Spacing="6">
                                                    <Label Text="TAP A TAG TO INSERT IT INTO YOUR PROMPT"
                                                           Style="{StaticResource SectionTitle}"
                                                           Margin="0,0,0,4" />

                                                    <!-- Tag chip palette -->
                                                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                                                        <BindableLayout.ItemsSource>
                                                            <Binding Source="{x:Reference PromptsPageRef}"
                                                                     Path="BindingContext.XmlTagButtons" />
                                                        </BindableLayout.ItemsSource>
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:XmlTagButton">
                                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,4,4">
                                                                    <!-- Tag insert button — style differs for built-in vs custom -->
                                                                    <Button Grid.Column="0"
                                                                            Text="{Binding Label}"
                                                                            Style="{StaticResource XmlTagChipBtn}"
                                                                            Margin="0"
                                                                            Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.AppendXmlTagCommand}"
                                                                            CommandParameter="{Binding .}"
                                                                            ToolTipProperties.Text="Insert this XML tag snippet at the end of the prompt" />
                                                                    <!-- Delete button for custom tags only -->
                                                                    <Button Grid.Column="1"
                                                                            Text="✕"
                                                                            Style="{StaticResource SmallIconBtn}"
                                                                            TextColor="{StaticResource TextError}"
                                                                            IsVisible="{Binding IsCustom}"
                                                                            Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.DeleteXmlTagButtonCommand}"
                                                                            CommandParameter="{Binding .}"
                                                                            ToolTipProperties.Text="Delete this custom tag button" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>

                                                    <!-- Add custom tag button -->
                                                    <Button Text="＋ Custom tag"
                                                            Style="{StaticResource XmlTagCustomChipBtn}"
                                                            HorizontalOptions="Start"
                                                            Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.RequestAddCustomXmlTagCommand}"
                                                            ToolTipProperties.Text="Create a reusable custom XML tag button with your own open/close tags and placeholder text" />

                                                    <Label Text="Tip: use [PASTE CHUNK] (📎 Insert Code) to mark where CopyCat pastes the chunked code."
                                                           Style="{StaticResource HintLabel}" Margin="0,2,0,0" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Freehand editor — always visible -->
                                            <Border Style="{StaticResource InputBorder}">
                                                <Editor Style="{StaticResource InlineEditor}"
                                                        Text="{Binding EditContent}"
                                                        Placeholder="Prompt text… Use [PASTE CHUNK] where you want the code inserted. If omitted, code is appended after the prompt." />
                                            </Border>

                                            <!-- Save / Cancel / Delete row -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Button Grid.Column="0" Style="{StaticResource SmallIconBtn}"
                                                        Text="🗑 Delete"
                                                        IsVisible="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.DeletePromptCommand}"
                                                        CommandParameter="{Binding .}"
                                                        TextColor="{StaticResource TextError}"
                                                        ToolTipProperties.Text="Permanently delete this custom prompt" />
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Text="Save"
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.SavePromptCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Grid.Column="2" Style="{StaticResource SmallIconBtn}" Text="Cancel"
                                                        Command="{Binding Source={x:Reference PromptsPageRef}, Path=BindingContext.CancelEditPromptCommand}"
                                                        CommandParameter="{Binding .}"
                                                        TextColor="{StaticResource TextSecondary}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Add new prompt + Reset all buttons -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,24">
                    <Button Grid.Column="0" Text="+ New prompt"
                            Style="{StaticResource SecondaryBtn}"
                            Command="{Binding AddNewPromptCommand}"
                            ToolTipProperties.Text="Create a new custom AI prompt" />
                    <Button Grid.Column="1" Text="↺ Reset all"
                            Style="{StaticResource ResetPromptsBtn}"
                            x:Name="ResetPromptsButton"
                            ToolTipProperties.Text="Delete all custom prompts and restore the 6 built-in defaults" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════ BOTTOM DONE BAR -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BgSmartBar}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderDefault}">
            <Border.Padding>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="iOS"     Value="16,10,16,44" />
                    <On Platform="Android" Value="16,10,16,16" />
                    <On Platform="WinUI"   Value="16,10,16,16" />
                    <On Platform="MacCatalyst" Value="16,10,16,16" />
                </OnPlatform>
            </Border.Padding>
            <Button Text="← Done — return to chunking"
                    Style="{StaticResource SecondaryBtn}"
                    Command="{Binding GoBackCommand}"
                    ToolTipProperties.Text="Return to the main view. Your prompt selection is remembered." />
        </Border>

    </Grid>
</ContentPage>
