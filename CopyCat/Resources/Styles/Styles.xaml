<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:CopyCat.Converters"
                    x:Class="CopyCat.Resources.Styles.Styles">

    <Color x:Key="C_Amber">#F59E0B</Color>
    <Color x:Key="C_DeepTeal">#003B46</Color>
    <Color x:Key="C_MidiTeal">#006770</Color>
    <Color x:Key="C_Dark">#070F12</Color>
    <Color x:Key="C_Cyan">#00A3A9</Color>
    <Color x:Key="C_Teal">#008C8B</Color>
    <Color x:Key="C_AmberLight">#FCD34D</Color>
    <Color x:Key="C_TransTeal">#1A00D4AA</Color>
    <Color x:Key="C_Red">#FF7070</Color>

    <Color x:Key="BgApp">#070F12</Color>
    <Color x:Key="BgCard">#003B46</Color>
    <Color x:Key="TextPrimary">#FCD34D</Color>
    <Color x:Key="TextMuted">#00A3A9</Color>
    <Color x:Key="BorderDefault">#006770</Color>

    <conv:BoolToColorConverter x:Key="ChipBorderConv" TrueColor="{StaticResource C_Amber}" FalseColor="{StaticResource C_MidiTeal}" />
    <conv:BoolToColorConverter x:Key="ChipBgConv"     TrueColor="{StaticResource C_Amber}" FalseColor="{StaticResource C_MidiTeal}" />
    <conv:BoolToColorConverter x:Key="SelectionDotBgConv" TrueColor="{StaticResource C_Amber}" FalseColor="Transparent" />
    <conv:BoolToColorConverter x:Key="SelectionDotBorderConv" TrueColor="{StaticResource C_Amber}" FalseColor="{StaticResource C_MidiTeal}" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:BoolToStringConverter x:Key="ExpandArrowConv" TrueValue="▲" FalseValue="▼" />
    <conv:BoolToStringConverter x:Key="SelectionHintConv" TrueValue="" FalseValue="tap cards to select" />

    <Style TargetType="Page">
        <Setter Property="BackgroundColor" Value="{StaticResource BgApp}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="White" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke"          Value="{StaticResource BorderDefault}" />
        <Setter Property="StrokeShape"     Value="RoundRectangle 14" />
        <Setter Property="Padding"          Value="14" />
        <Setter Property="Margin"           Value="0,0,0,10" />
    </Style>

    <Style x:Key="ListItemBase" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Dark}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape"     Value="RoundRectangle 12" />
        <Setter Property="Margin"          Value="0,0,0,8" />
    </Style>

    <Style x:Key="ChunkBorder" BasedOn="{StaticResource ListItemBase}" TargetType="Border" />
    <Style x:Key="PromptCardBorder" BasedOn="{StaticResource ListItemBase}" TargetType="Border" />

    <Style x:Key="InputBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Dark}" />
        <Setter Property="Stroke"          Value="{StaticResource C_MidiTeal}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape"     Value="RoundRectangle 10" />
    </Style>

    <Style x:Key="InputEntry" TargetType="Entry">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="PlaceholderColor" Value="{StaticResource C_Cyan}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="InlineEditor" TargetType="Editor">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="100" />
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Amber}" />
        <Setter Property="TextColor"       Value="{StaticResource C_Dark}" />
        <Setter Property="CornerRadius"    Value="14" />
        <Setter Property="FontAttributes"  Value="Bold" />
    </Style>

    <Style x:Key="SecondaryBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"       Value="{StaticResource C_Amber}" />
        <Setter Property="BorderColor"     Value="{StaticResource C_Amber}" />
        <Setter Property="BorderWidth"     Value="1" />
        <Setter Property="CornerRadius"    Value="12" />
    </Style>

    <Style x:Key="BackBtn" BasedOn="{StaticResource SecondaryBtn}" TargetType="Button" />

    <Style x:Key="ToggleAllBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource C_TransTeal}" />
        <Setter Property="TextColor"       Value="{StaticResource C_AmberLight}" />
        <Setter Property="FontSize"        Value="11" />
        <Setter Property="CornerRadius"    Value="8" />
        <Setter Property="Padding"         Value="8,2" />
    </Style>

    <Style x:Key="AutoDetectBtn" BasedOn="{StaticResource ToggleAllBtn}" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource C_Cyan}" />
    </Style>

    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"       Value="{StaticResource C_Cyan}" />
        <Setter Property="FontSize"        Value="18" />
    </Style>

    <Style x:Key="SmallIconBtn" BasedOn="{StaticResource IconBtn}" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="ResetPromptsBtn" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"       Value="{StaticResource C_Red}" />
        <Setter Property="BorderColor"     Value="{StaticResource C_Red}" />
        <Setter Property="BorderWidth"     Value="1" />
        <Setter Property="CornerRadius"    Value="10" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="TextColor"      Value="{StaticResource C_Cyan}" />
        <Setter Property="FontSize"       Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="Margin"         Value="0,0,0,8" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource C_Cyan}" />
        <Setter Property="FontSize"  Value="12" />
    </Style>

    <Style x:Key="CardTitleLabel" TargetType="Label">
        <Setter Property="TextColor"      Value="{StaticResource C_AmberLight}" />
        <Setter Property="FontSize"       Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="CardSubLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource C_Cyan}" />
        <Setter Property="FontSize"  Value="12" />
    </Style>

    <Style x:Key="SelectionDot" TargetType="Border">
        <Setter Property="WidthRequest"  Value="22" />
        <Setter Property="HeightRequest" Value="22" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeShape"     Value="RoundRectangle 11" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SelectionDotCheck" TargetType="Label">
        <Setter Property="Text" Value="✓" />
        <Setter Property="TextColor" Value="{StaticResource C_Dark}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource C_Amber}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource C_Dark}" />
        <Setter Property="ThumbColor"         Value="{StaticResource C_AmberLight}" />
    </Style>

    <Style x:Key="TokenBadgeBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_TransTeal}" />
        <Setter Property="Stroke"          Value="{StaticResource C_Amber}" />
        <Setter Property="Padding"          Value="8,4" />
        <Setter Property="StrokeShape"     Value="RoundRectangle 8" />
    </Style>

    <Style x:Key="ErrorBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource C_Dark}" />
        <Setter Property="Stroke"          Value="{StaticResource C_Red}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding"          Value="10" />
    </Style>

</ResourceDictionary>