<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CopyCat.ViewModels"
             xmlns:models="clr-namespace:CopyCat.Models"
             xmlns:behaviors="clr-namespace:CopyCat.Behaviors"
             x:Class="CopyCat.MainPage"
             x:DataType="vm:MainViewModel"
             x:Name="ThisPage"
             BackgroundColor="{StaticResource BgApp}">

    <Grid RowDefinitions="*,Auto">

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 0 — SCROLLABLE CONTENT
             ═══════════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Padding="14,14,14,8" Spacing="0">

                <!-- ════════════════════════════════════════════════════
                     CONFIGURATION PANEL
                     ════════════════════════════════════════════════════ -->
                <VerticalStackLayout IsVisible="{Binding IsConfigurationMode}" Spacing="0">

                    <!-- ── REPOSITORY CARD ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">

                            <!-- Header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <Label Grid.Column="0" Text="REPOSITORY" Style="{StaticResource SectionTitle}"
                                       Margin="0" VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="💾 Save workspace"
                                        Style="{StaticResource SmallIconBtn}"
                                        Command="{Binding SaveWorkspaceCommand}"
                                        IsVisible="{Binding HasSelectedRepo}"
                                        ToolTipProperties.Text="Save current file types, excluded folders, token limit and active AI prompt as defaults for this repository. Restores automatically on next selection." />
                            </Grid>

                            <!-- URL field -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="GitHub URL or local path"
                                       Style="{StaticResource FieldLabel}" Margin="0" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="ⓘ"
                                       TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowInfoCommand}"
                                                              CommandParameter="Paste a GitHub repo URL (https://github.com/owner/repo) or a local folder path (e.g. C:\Projects\MyApp or /Users/me/code). Tap 📋 to paste from clipboard. On Android/iOS you can also share a URL directly from your browser." />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Entry Grid.Column="0" Style="{StaticResource InputEntry}"
                                           Text="{Binding RepoUrl}"
                                           Placeholder="https://github.com/owner/repo  or  C:\Projects"
                                           Keyboard="Url" ReturnType="Next" Margin="4,0,0,0"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Text="✕"
                                            Command="{Binding ClearUrlCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            ToolTipProperties.Text="Clear URL field" />
                                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Text="📋"
                                            Command="{Binding PasteUrlCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            ToolTipProperties.Text="Paste URL from clipboard" />
                                </Grid>
                            </Border>

                            <!-- ── Saved repos — BindableLayout replaces CollectionView (Android fix) -->
                            <VerticalStackLayout IsVisible="{Binding HasSavedRepos}" Spacing="0">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                                    <Label Grid.Column="0" Text="Recent repositories"
                                           Style="{StaticResource FieldLabel}" Margin="0" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallIconBtn}" Text="✎  Rename"
                                            Command="{Binding RenameSelectedRepoCommand}"
                                            IsVisible="{Binding HasSelectedRepo}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            ToolTipProperties.Text="Give this repository a friendly display name" />
                                    <Button Grid.Column="2" Style="{StaticResource SmallIconBtn}" Text="✕"
                                            Command="{Binding ClearSelectedRepoCommand}"
                                            IsVisible="{Binding HasSelectedRepo}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            ToolTipProperties.Text="Deselect this repository" />
                                </Grid>

                                <!-- FIX: BindableLayout replaces CollectionView inside ScrollView (Android layout bug) -->
                                <Border Style="{StaticResource SavedReposListBorder}">
                                    <VerticalStackLayout Spacing="0">
                                        <BindableLayout.ItemsSource>
                                            <Binding Path="SavedRepos" />
                                        </BindableLayout.ItemsSource>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:SavedRepo">
                                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="10,8">
                                                    <Label Grid.Column="0" Text="{Binding DisplayName}"
                                                           Style="{StaticResource SavedRepoRowLabel}" VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectRepoCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <Label Grid.Column="1"
                                                           Text="●"
                                                           TextColor="{StaticResource AccentSecond}"
                                                           FontSize="8"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding HasWorkspace}"
                                                           ToolTipProperties.Text="Workspace settings saved for this repo" />
                                                    <Button Grid.Column="2" Style="{StaticResource SmallIconBtn}" Text="🗑"
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteRepoCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ToolTipProperties.Text="Remove from recent list" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" Margin="0,4,0,10" />

                            <!-- Branch -->
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,4" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="Branch" Style="{StaticResource FieldLabel}" Margin="0" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="ⓘ" TextColor="{StaticResource AccentPrimary}"
                                       FontSize="16" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowInfoCommand}"
                                                              CommandParameter="Tap the branch field to open the branch picker. CopyCat tries main → master → develop as fallbacks if the selected branch doesn't exist. Selecting a branch triggers automatic file-type detection." />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,6">
                                <Grid HeightRequest="50">
                                    <Grid IsVisible="{Binding IsFetchingBranches, Converter={StaticResource InverseBool}}"
                                          ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding BranchButtonLabel}"
                                               Style="{StaticResource BranchPickerLabel}" VerticalOptions="Center" Margin="12,0,0,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowBranchPickerCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Column="1" Text="⇅" TextColor="{StaticResource TextMuted}"
                                               FontSize="16" VerticalOptions="Center" Margin="0,0,12,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowBranchPickerCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowBranchPickerCommand}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    <HorizontalStackLayout IsVisible="{Binding IsFetchingBranches}"
                                                           HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                        <ActivityIndicator IsRunning="{Binding IsFetchingBranches}"
                                                           Color="{StaticResource AccentPrimary}"
                                                           HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                        <Label Text="Loading branches…" TextColor="{StaticResource TextMuted}"
                                               FontSize="13" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>

                            <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" Margin="0,4,0,10" />

                            <!-- GitHub Token -->
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,4" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="GitHub Token (private repos)"
                                       Style="{StaticResource FieldLabel}" Margin="0" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="ⓘ" TextColor="{StaticResource AccentPrimary}"
                                       FontSize="16" VerticalOptions="Center" Margin="2,0,0,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowTokenInfoCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Border Grid.Column="3" Style="{StaticResource SavedTokenBorder}" IsVisible="{Binding TokenIsSaved}">
                                    <Label Text="✓ Saved" TextColor="{StaticResource AccentSecond}" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource InputBorder}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0" Style="{StaticResource InputEntry}"
                                           Text="{Binding AccessToken}"
                                           Placeholder="ghp_… (leave empty for public repos)"
                                           IsPassword="True" ReturnType="Done"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Text="🗑"
                                            Command="{Binding ClearTokenCommand}"
                                            IsVisible="{Binding TokenIsSaved}"
                                            ToolTipProperties.Text="Remove saved token from secure storage" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── FILE TYPES ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="FILE TYPES" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowInfoCommand}"
                                                                  CommandParameter="Green chip = included in chunking. Grey chip = excluded. Tap 🔍 Auto to scan the repo and enable matching types automatically. Tap individual chips to toggle them. Tap 'Toggle all' to flip all at once." />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Style="{StaticResource AutoDetectBtn}" Text="🔍 Auto"
                                        Command="{Binding AutoDetectFileTypesCommand}"
                                        IsVisible="{Binding CanAutoDetect}"
                                        IsEnabled="{Binding IsAutoDetecting, Converter={StaticResource InverseBool}}"
                                        ToolTipProperties.Text="Scan the repository to detect which file types are present, then enable matching filters automatically" />
                                <Button Grid.Column="2" Style="{StaticResource ToggleAllBtn}" Text="Toggle all"
                                        Command="{Binding ToggleAllFileTypesCommand}"
                                        IsVisible="{Binding IsFileTypesExpanded}"
                                        ToolTipProperties.Text="Enable or disable all file type filters at once" />
                                <Label Grid.Column="3"
                                       Text="{Binding IsFileTypesExpanded, Converter={StaticResource ExpandArrowConv}}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFileTypesCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFileTypesCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <Label Text="{Binding AutoDetectStatusText}" FontSize="11"
                                   TextColor="{StaticResource AccentSecond}" Margin="0,2,0,6"
                                   IsVisible="{Binding HasAutoDetectStatus}" LineBreakMode="WordWrap" />

                            <Label Text="{Binding FileTypeCardSummary}" Style="{StaticResource FilterSummaryLabel}"
                                   IsVisible="{Binding IsFileTypesExpanded, Converter={StaticResource InverseBool}}" />

                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                        IsVisible="{Binding IsFileTypesExpanded}">
                                <BindableLayout.ItemsSource><Binding Path="FileTypeFilters" /></BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileTypeFilter">
                                        <Border Style="{StaticResource ChipBorder}"
                                                BackgroundColor="{Binding IsEnabled, Converter={StaticResource ChipIncludedBgConv}}"
                                                Stroke="{Binding IsEnabled, Converter={StaticResource ChipIncludedBorderConv}}">
                                            <Label Text="{Binding Label}" Style="{StaticResource ChipLabel}"
                                                   TextColor="{Binding IsEnabled, Converter={StaticResource ChipLabelColorConv}}" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFileTypeCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── EXCLUDE FOLDERS ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="EXCLUDE FOLDERS" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowInfoCommand}"
                                                                  CommandParameter="Red chip = folder excluded from chunking. Green = included. Tap any chip to toggle. Type a custom folder name in the field below and tap + Add. Common folders like bin, obj, node_modules are excluded by default." />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Style="{StaticResource ToggleAllBtn}" Text="Toggle all"
                                        Command="{Binding ToggleAllFolderFiltersCommand}"
                                        IsVisible="{Binding IsFoldersExpanded}"
                                        ToolTipProperties.Text="Flip all folder exclusions on or off at once" />
                                <Label Grid.Column="2"
                                       Text="{Binding IsFoldersExpanded, Converter={StaticResource ExpandArrowConv}}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFoldersCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFoldersCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <Label Text="{Binding FolderFilterSummary}" Style="{StaticResource FilterSummaryLabel}"
                                   IsVisible="{Binding IsFoldersExpanded, Converter={StaticResource InverseBool}}" />

                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                        IsVisible="{Binding IsFoldersExpanded}">
                                <BindableLayout.ItemsSource><Binding Path="FolderFilters" /></BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FolderFilter">
                                        <Border Style="{StaticResource ChipBorder}"
                                                BackgroundColor="{Binding IsExcluded, Converter={StaticResource ChipExcludedBgConv}}"
                                                Stroke="{Binding IsExcluded, Converter={StaticResource ChipExcludedBorderConv}}">
                                            <Label Text="{Binding Name}" Style="{StaticResource ChipLabel}"
                                                   TextColor="{Binding IsExcluded, Converter={StaticResource ChipLabelColorConv}}" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFolderCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                  IsVisible="{Binding IsFoldersExpanded}" Margin="0,6,0,0">
                                <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                    <Entry Style="{StaticResource InputEntry}"
                                           Text="{Binding CustomFolderInput}"
                                           Placeholder="Add folder name… (e.g. migrations)"
                                           ReturnType="Done" ReturnCommand="{Binding AddCustomFolderCommand}"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource ToggleAllBtn}" Text="+ Add"
                                        Command="{Binding AddCustomFolderCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        ToolTipProperties.Text="Add this folder name to the exclusion list" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── EXCLUDE FILE PATTERNS ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="EXCLUDE FILE PATTERNS" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowInfoCommand}"
                                                                  CommandParameter="Red chip = pattern active (files whose names match are excluded). Use glob patterns with * wildcards. Examples: *Test* excludes TestHelper.cs, *Spec* excludes UserSpec.ts, *.min.* excludes app.min.js, Program.cs excludes that exact file. Enter comma-separated patterns and tap + Add." />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Style="{StaticResource ToggleAllBtn}" Text="Toggle all"
                                        Command="{Binding ToggleAllFilePatternsCommand}"
                                        IsVisible="{Binding IsFilePatternsExpanded}"
                                        ToolTipProperties.Text="Enable or disable all file pattern exclusions at once" />
                                <Label Grid.Column="2"
                                       Text="{Binding IsFilePatternsExpanded, Converter={StaticResource ExpandArrowConv}}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFilePatternsCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFilePatternsCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <Label Text="{Binding FilePatternSummary}" Style="{StaticResource FilterSummaryLabel}"
                                   IsVisible="{Binding IsFilePatternsExpanded, Converter={StaticResource InverseBool}}" />

                            <VerticalStackLayout IsVisible="{Binding IsFilePatternsExpanded}" Spacing="0">
                                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                                    <BindableLayout.ItemsSource><Binding Path="FilePatternFilters" /></BindableLayout.ItemsSource>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:FilePatternFilter">
                                            <Border Style="{StaticResource ChipBorder}"
                                                    BackgroundColor="{Binding IsEnabled, Converter={StaticResource ChipExcludedBgConv}}"
                                                    Stroke="{Binding IsEnabled, Converter={StaticResource ChipExcludedBorderConv}}">
                                                <Label Text="{Binding Pattern}" Style="{StaticResource ChipLabel}"
                                                       TextColor="{Binding IsEnabled, Converter={StaticResource ChipLabelColorConv}}" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFilePatternCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                    <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                        <Entry Style="{StaticResource InputEntry}"
                                               Text="{Binding CustomPatternInput}"
                                               Placeholder="e.g. *Test*, *Spec*, *.backup.*  (comma-separated)"
                                               ReturnType="Done" ReturnCommand="{Binding AddCustomPatternCommand}"
                                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource ToggleAllBtn}" Text="+ Add"
                                            Command="{Binding AddCustomPatternCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            ToolTipProperties.Text="Add pattern(s) to the exclusion list. Comma-separate multiple patterns." />
                                </Grid>

                                <!-- Fetched file browser — visible only after a fetch -->
                                <VerticalStackLayout IsVisible="{Binding HasFetchedFiles}" Margin="0,12,0,0" Spacing="0">
                                    <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" Opacity="0.5" Margin="0,0,0,8" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding FetchedFilesCountLabel}"
                                               Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding IsFetchedFilesExpanded, Converter={StaticResource ExpandArrowConv}}"
                                               TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleFetchedFilesCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleFetchedFilesCommand}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>

                                    <Label Text="Tap the ○/✕ icon to include or exclude individual files from chunking. Excluded files are highlighted in red."
                                           Style="{StaticResource HintLabel}" Margin="0,2,0,6"
                                           IsVisible="{Binding IsFetchedFilesExpanded}" />

                                    <!-- FIX: HeightRequest on ScrollView so Android can measure it.
                                         BindableLayout replaces CollectionView — avoids nested CollectionView+ScrollView bug. -->
                                    <Border IsVisible="{Binding IsFetchedFilesExpanded}"
                                            BackgroundColor="{StaticResource BgPreview}"
                                            StrokeThickness="1" Stroke="{StaticResource BorderDefault}"
                                            StrokeShape="RoundRectangle 8" Padding="0">
                                        <ScrollView Orientation="Vertical" HeightRequest="300">
                                            <VerticalStackLayout Spacing="0">
                                                <BindableLayout.ItemsSource>
                                                    <Binding Path="FetchedFiles" />
                                                </BindableLayout.ItemsSource>
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:FetchedFileEntry">
                                                        <Grid ColumnDefinitions="Auto,*"
                                                              Padding="12,5"
                                                              BackgroundColor="{Binding RowBackground}">
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding ExcludeIcon}"
                                                                   TextColor="{Binding ExcludeIconColor}"
                                                                   FontSize="13" VerticalOptions="Center"
                                                                   Margin="0,0,10,0"
                                                                   ToolTipProperties.Text="Tap to toggle file exclusion">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer
                                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFetchedFileExclusionCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                                                <Label Text="{Binding FileName}"
                                                                       Style="{StaticResource FetchedFileRowLabel}">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFetchedFileExclusionCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                                <Label Text="{Binding Folder}"
                                                                       TextColor="{StaticResource TextDim}"
                                                                       FontSize="10" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </ScrollView>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── AI PROMPTS — compact card (full management on PromptsPage) ── -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                <Label Text="AI PROMPT" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                <Label Text="{Binding SelectedPromptLabel}"
                                       TextColor="{StaticResource AccentSecond}"
                                       FontSize="12" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="⚙ Manage Prompts"
                                    Style="{StaticResource ToggleAllBtn}"
                                    Command="{Binding NavigateToPromptsPageCommand}"
                                    ToolTipProperties.Text="Open the AI Prompt Library — select, edit or create prompts that are prepended to every chunk you copy" />
                        </Grid>
                    </Border>

                    <!-- ── TOKEN SLIDER ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="MAX TOKENS / CHUNK" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowInfoCommand}"
                                                                  CommandParameter="Controls how many tokens fit in one chunk (~4 characters = 1 token). Fewer tokens = more chunks to paste, but each paste is smaller. More tokens = fewer pastes but may exceed your AI's context window. Recommended: 16K for GPT-4 Turbo, Claude 3+, Gemini 1.5. Use 32K only for models with large context windows." />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource TokenBadgeBorder}">
                                    <Label Text="{Binding MaxTokensLabel}" Style="{StaticResource TokenBadgeLabel}" />
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,0,0,8">
                                <Button Grid.Column="0" Text="4K"    Style="{StaticResource SliderPresetBtn}"
                                        Command="{Binding SetPresetTokensCommand}" CommandParameter="4000"
                                        ToolTipProperties.Text="4,096 tokens — fits GPT-3.5 Turbo and basic AI chat interfaces" />
                                <Button Grid.Column="1" Text="8K"    Style="{StaticResource SliderPresetBtn}"
                                        Command="{Binding SetPresetTokensCommand}" CommandParameter="8000"
                                        ToolTipProperties.Text="8,192 tokens — good balance for GPT-4 (8K context)" />
                                <Button Grid.Column="2" Text="★ 16K" Style="{StaticResource SliderPresetBtn}"
                                        Command="{Binding SetPresetTokensCommand}" CommandParameter="16000"
                                        ToolTipProperties.Text="16,384 tokens — RECOMMENDED for GPT-4 Turbo, Claude 3+, Gemini 1.5" />
                                <Button Grid.Column="3" Text="32K"   Style="{StaticResource SliderPresetBtn}"
                                        Command="{Binding SetPresetTokensCommand}" CommandParameter="32000"
                                        ToolTipProperties.Text="32,768 tokens — maximum; only use with large-context models (Claude Opus, GPT-4 32K)" />
                            </Grid>
                            <Label Text="{Binding SliderWarningText}" TextColor="{Binding SliderWarningColor}"
                                   Style="{StaticResource SliderWarningLabel}" />
                            <Slider Minimum="1000" Maximum="32000" Value="{Binding MaxTokensPerChunk, Mode=TwoWay}"
                                    MinimumTrackColor="{StaticResource SliderTrackActive}"
                                    MaximumTrackColor="{StaticResource SliderTrackInactive}"
                                    ThumbColor="{StaticResource SliderThumb}" HeightRequest="40"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="1 000" TextColor="{StaticResource TextDim}" FontSize="10" />
                                <Label Grid.Column="1" Text="32 000" TextColor="{StaticResource TextDim}" FontSize="10" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ErrorBorder}" IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="⚠️" FontSize="18" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource ErrorLabel}" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- ════════════════════════════════════════════════════
                     RESULTS PANEL
                     ════════════════════════════════════════════════════ -->
                <VerticalStackLayout IsVisible="{Binding IsResultsMode}" Spacing="0">

                    <!-- Busy indicator -->
                    <VerticalStackLayout IsVisible="{Binding IsBusy}" HorizontalOptions="Center"
                                         Spacing="10" Margin="0,0,0,10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           Color="{StaticResource ActivityIndicatorColor}"
                                           HeightRequest="36" WidthRequest="36" HorizontalOptions="Center" />
                        <Label Text="{Binding StatusText}" TextColor="{StaticResource TextSecondary}"
                               FontSize="14" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource ErrorBorder}" IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="⚠️" FontSize="18" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource ErrorLabel}" />
                        </Grid>
                    </Border>

                    <!-- Summary stats -->
                    <Border Style="{StaticResource SummaryBorder}" IsVisible="{Binding HasChunks}">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalFiles}"    Style="{StaticResource StatNumberLabel}" />
                                <Label Text="files"                   Style="{StaticResource StatCaptionLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalProjects}" Style="{StaticResource StatNumberLabel}" />
                                <Label Text="projects"                Style="{StaticResource StatCaptionLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding ChunkCount}"    Style="{StaticResource StatNumberLabel}" />
                                <Label Text="chunks"                  Style="{StaticResource StatCaptionLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalTokens}"   Style="{StaticResource StatNumberLabel}" />
                                <Label Text="tokens"                  Style="{StaticResource StatCaptionLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Active AI Prompt card — shown after chunking -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasChunks}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                <Label Text="AI PROMPT" Style="{StaticResource SectionTitle}" Margin="0" />
                                <Label Text="{Binding SelectedPromptLabel}"
                                       TextColor="{StaticResource AccentSecond}"
                                       FontSize="12" LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="⚙"
                                    Style="{StaticResource IconBtn}"
                                    Command="{Binding NavigateToPromptsPageCommand}"
                                    ToolTipProperties.Text="Open AI Prompt Library to select or edit prompts. The active prompt is prepended to every chunk you copy." />
                        </Grid>
                    </Border>

                    <!-- CHUNK LIST -->
                    <VerticalStackLayout IsVisible="{Binding HasChunks}" Spacing="0">

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                            <Label Grid.Column="0" Text="CHUNKS" Style="{StaticResource SectionTitle}"
                                   Margin="0" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{Binding SelectAllChunksLabel}"
                                    Style="{StaticResource ToggleAllBtn}"
                                    Command="{Binding SelectAllChunksCommand}"
                                    ToolTipProperties.Text="Select all chunks to copy or share multiple at once. Tap again to deselect all." />
                            <Label Grid.Column="2"
                                   Text="{Binding HasSelection, Converter={StaticResource SelectionHintConv}}"
                                   TextColor="{StaticResource TextMuted}" FontSize="11" VerticalOptions="Center" />
                        </Grid>

                        <!-- Search bar -->
                        <Border Style="{StaticResource InputBorder}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0" Style="{StaticResource InputEntry}"
                                       Text="{Binding ChunkSearchText}"
                                       Placeholder="Search chunk titles and content…" Margin="4,0,0,0" />
                                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Text="✕"
                                        Command="{Binding ClearChunkSearchCommand}"
                                        IsVisible="{Binding ChunkSearchText, Converter={StaticResource StringNotEmptyConv}}"
                                        ToolTipProperties.Text="Clear search filter" />
                            </Grid>
                        </Border>

                        <Label Text="{Binding ChunkSearchSummary}"
                               TextColor="{StaticResource TextMuted}" FontSize="11"
                               Margin="0,0,0,6"
                               IsVisible="{Binding ChunkSearchText, Converter={StaticResource StringNotEmptyConv}}" />

                        <!-- FIX: BindableLayout replaces CollectionView inside page ScrollView (Android bug).
                             All chunks are rendered eagerly. Performance is acceptable because:
                             - Chunks start collapsed (IsPreviewExpanded = false)
                             - Heavy file content is only rendered when the user expands a card
                             - The SequenceEqual optimization in RefreshFilteredChunks prevents
                               unnecessary clears on every keystroke in the search box. -->
                        <VerticalStackLayout Spacing="0">
                            <BindableLayout.ItemsSource>
                                <Binding Path="FilteredChunks" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CodeChunk">

                                    <Border Style="{StaticResource ChunkBorder}"
                                            Stroke="{Binding CardBorderColor}"
                                            StrokeThickness="{Binding CardBorderThickness}">
                                        <Border.Behaviors>
                                            <behaviors:TactileCopyBehavior />
                                        </Border.Behaviors>

                                        <VerticalStackLayout Spacing="0">

                                            <!-- Three-zone grid -->
                                            <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,90">

                                                <!-- ZONE A — Select (tap = toggle selection) -->
                                                <Grid Grid.Row="0" Grid.Column="0"
                                                      BackgroundColor="{Binding ZoneABackground}"
                                                      Padding="14,12,10,12">
                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                                        <!-- Selection dot -->
                                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                                Style="{StaticResource SelectionDot}"
                                                                BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectionDotBgConv}}"
                                                                Stroke="{Binding IsSelected, Converter={StaticResource SelectionDotBorderConv}}"
                                                                VerticalOptions="Center">
                                                            <Label Style="{StaticResource SelectionDotCheck}" IsVisible="{Binding IsSelected}" />
                                                        </Border>
                                                        <!-- Title -->
                                                        <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding DisplayLabel}"
                                                               Style="{StaticResource ChunkTitleLabel}" />
                                                        <!-- Token count + warning icon -->
                                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="0">
                                                            <Label Text="{Binding SubLabel}" Style="{StaticResource ChunkSubLabel}" />
                                                            <Label Text="{Binding ChunkWarningIcon}"
                                                                   Style="{StaticResource ChunkWarningLabelStyle}"
                                                                   IsVisible="{Binding ChunkWarningIcon, Converter={StaticResource StringNotEmptyConv}}"
                                                                   ToolTipProperties.Text="⛔ &gt;128K — exceeds most AI context windows&#10;⚠️ &gt;32K — too large for GPT-3.5&#10;ℹ️ &gt;16K — fine for GPT-4 Turbo, Claude, Gemini" />
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleChunkSelectionCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>
                                                </Grid>

                                                <!-- Zone A/B separator -->
                                                <BoxView Grid.Row="0" Grid.Column="0"
                                                         HorizontalOptions="End"
                                                         Style="{StaticResource CardZoneSeparatorView}" />

                                                <!-- ZONE B — Copy (tap = copy, never affects selection) -->
                                                <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                                                                     VerticalOptions="Center"
                                                                     HorizontalOptions="Center"
                                                                     Spacing="4" Padding="0,8">
                                                    <Border Style="{StaticResource CopiedBadgeBorder}"
                                                            IsVisible="{Binding IsCopied}"
                                                            HorizontalOptions="Center">
                                                        <Label Style="{StaticResource CopiedBadgeLabel}" />
                                                    </Border>
                                                    <Button Text="Copy"
                                                            Style="{StaticResource ChunkActionBtn}"
                                                            MinimumWidthRequest="68"
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CopyChunkCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ToolTipProperties.Text="Copy this chunk (with active AI prompt if selected) to clipboard" />
                                                </VerticalStackLayout>

                                                <!-- ZONE C — Expand strip -->
                                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Style="{StaticResource CardZoneCBorder}">
                                                    <Grid ColumnDefinitions="*,Auto" HeightRequest="36">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding PreviewToggleIcon}"
                                                               TextColor="{StaticResource TextMuted}"
                                                               FontSize="11" VerticalOptions="Center"
                                                               HorizontalTextAlignment="Center" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding SubLabel}"
                                                               TextColor="{StaticResource TextDim}"
                                                               FontSize="10" VerticalOptions="Center"
                                                               Margin="0,0,14,0" />
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePreviewCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Grid.GestureRecognizers>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- Expanded file entries -->
                                            <VerticalStackLayout IsVisible="{Binding IsPreviewExpanded}" Spacing="0">

                                                <!-- File list header with select/deselect all -->
                                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="12,6,8,2">
                                                    <Label Grid.Column="0" Text="FILES IN THIS CHUNK"
                                                           Style="{StaticResource SectionTitle}"
                                                           Margin="0" VerticalOptions="Center" />
                                                    <Button Grid.Column="1"
                                                            Text="✓ All"
                                                            Style="{StaticResource SmallIconBtn}"
                                                            TextColor="{StaticResource AccentSecond}"
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.IncludeAllChunkFilesCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ToolTipProperties.Text="Include all files in this chunk when copying" />
                                                    <Button Grid.Column="2"
                                                            Text="✕ All"
                                                            Style="{StaticResource SmallIconBtn}"
                                                            TextColor="{StaticResource TextError}"
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ExcludeAllChunkFilesCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ToolTipProperties.Text="Exclude all files from this chunk — useful when you only want one file included" />
                                                </Grid>

                                                <!-- Per-file rows -->
                                                <VerticalStackLayout Spacing="0">
                                                    <BindableLayout.ItemsSource><Binding Path="FileEntries" /></BindableLayout.ItemsSource>
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ChunkFile">
                                                            <VerticalStackLayout Spacing="0">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,6"
                                                                      BackgroundColor="{Binding RowBackground}">
                                                                    <Label Grid.Column="0" Text="{Binding ExcludeIcon}"
                                                                           TextColor="{Binding ExcludeIconColor}"
                                                                           FontSize="13" VerticalOptions="Center" Margin="0,0,8,0"
                                                                           ToolTipProperties.Text="Tap to include or exclude this file from copying">
                                                                        <Label.GestureRecognizers>
                                                                            <TapGestureRecognizer
                                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFileEntryExclusionCommand}"
                                                                                CommandParameter="{Binding .}" />
                                                                        </Label.GestureRecognizers>
                                                                    </Label>
                                                                    <Label Grid.Column="1" Text="{Binding FileName}"
                                                                           TextColor="{StaticResource TextSecondary}"
                                                                           FontSize="12" FontFamily="OpenSansSemibold"
                                                                           VerticalOptions="Center">
                                                                        <Label.GestureRecognizers>
                                                                            <TapGestureRecognizer
                                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFileCodeCommand}"
                                                                                CommandParameter="{Binding .}" />
                                                                        </Label.GestureRecognizers>
                                                                    </Label>
                                                                    <Label Grid.Column="2" Text="{Binding ExpandIcon}"
                                                                           TextColor="{StaticResource TextMuted}"
                                                                           FontSize="11" VerticalOptions="Center" Margin="0,0,4,0"
                                                                           ToolTipProperties.Text="Tap to show or hide the file's source code inline">
                                                                        <Label.GestureRecognizers>
                                                                            <TapGestureRecognizer
                                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFileCodeCommand}"
                                                                                CommandParameter="{Binding .}" />
                                                                        </Label.GestureRecognizers>
                                                                    </Label>
                                                                </Grid>
                                                                <ScrollView IsVisible="{Binding IsCodeExpanded}"
                                                                            Orientation="Horizontal"
                                                                            HeightRequest="240"
                                                                            BackgroundColor="{StaticResource BgApp}">
                                                                    <Label Text="{Binding Content}"
                                                                           FontFamily="Courier New" FontSize="11"
                                                                           TextColor="{StaticResource TextMuted}"
                                                                           LineBreakMode="NoWrap" Padding="14,8" />
                                                                </ScrollView>
                                                                <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" Opacity="0.4" />
                                                            </VerticalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>

                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 1 — SMART ACTION BAR
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource SmartActionBarBorder}" Padding="16,10,16,50">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                <!-- Busy row -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsBusy}">
                    <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsBusy}"
                                       Color="{StaticResource AccentPrimary}"
                                       HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding StatusText}"
                           TextColor="{StaticResource TextSecondary}" FontSize="13"
                           VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                    <Button Grid.Column="2" Text="Abort" Style="{StaticResource SecondaryBtn}"
                            FontSize="13" MinimumHeightRequest="40" Command="{Binding CancelCommand}"
                            ToolTipProperties.Text="Cancel the current fetch or chunking operation" />
                </Grid>

                <!-- Copy progress -->
                <Label Grid.Row="0" Text="{Binding CopyProgressLabel}"
                       TextColor="{StaticResource AccentSecond}"
                       FontSize="12" FontFamily="OpenSansSemibold"
                       HorizontalOptions="Center"
                       IsVisible="{Binding HasCopyProgress}"
                       Margin="0,2,0,0" />

                <!-- Config mode: Chunk button -->
                <Button Grid.Row="1"
                        ImageSource="copycat_logo.svg"
                        Style="{StaticResource PrimaryBtn}"
                        HeightRequest="90" ContentLayout="Top,0"
                        Command="{Binding FetchCommand}"
                        IsVisible="{Binding IsConfigurationMode}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        ToolTipProperties.Text="Fetch the repository and split into token-bounded chunks ready for pasting into an AI chat" />

                <!-- Results mode — no selection: Reset + Next + Edit Config -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="8"
                      IsVisible="{Binding IsResultsAndNoSelection}">
                    <Button Grid.Column="0" Text="🔄  Reset"
                            Style="{StaticResource SecondaryBtn}"
                            Command="{Binding ResetCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTipProperties.Text="Clear all results and return to configuration" />
                    <Button Grid.Column="1" Text="▶ Next"
                            Style="{StaticResource ChunkActionBtn}"
                            Command="{Binding CopyNextChunkCommand}"
                            IsVisible="{Binding HasChunks}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTipProperties.Text="Copy the next un-copied chunk to clipboard and advance the progress counter" />
                    <Button Grid.Column="2" Text="⚙  Edit Config"
                            Style="{StaticResource BackBtn}"
                            Command="{Binding BackToConfigurationCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            ToolTipProperties.Text="Return to configuration to adjust filters without clearing results" />
                </Grid>

                <!-- Selection toolbar -->
                <Border Grid.Row="1"
                        Style="{StaticResource SelectionToolbarBorder}"
                        IsVisible="{Binding HasSelection}"
                        ZIndex="1">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                                <Label Text="{Binding ShareSelectedLabel}" Style="{StaticResource SelectionCountLabel}" />
                                <Label Text="{Binding SelectedTokensLabel}" Style="{StaticResource SelectionTokensLabel}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="✕"
                                    Style="{StaticResource IconBtn}"
                                    Command="{Binding ClearSelectionCommand}"
                                    ToolTipProperties.Text="Deselect all chunks" />
                            <Button Grid.Column="2" Text="⊕ Merge"
                                    Style="{StaticResource ToggleAllBtn}"
                                    Command="{Binding MergeSelectedCommand}"
                                    IsVisible="{Binding CanMerge}"
                                    ToolTipProperties.Text="Merge selected chunks into one combined chunk" />
                            <Button Grid.Column="3" Text="📋 Copy"
                                    Style="{StaticResource CopySelectedBtn}"
                                    Command="{Binding CopySelectedCommand}"
                                    ToolTipProperties.Text="Copy all selected chunks (with active AI prompt) to clipboard" />
                            <Button Grid.Column="4" Text="↗ Share"
                                    Style="{StaticResource ShareBtn}"
                                    Command="{Binding ShareSelectedCommand}"
                                    ToolTipProperties.Text="Open the system share sheet to send selected chunks to another app" />
                        </Grid>
                        <Label Grid.Row="1"
                               Text="{Binding SelectionWarningLabel}"
                               TextColor="{Binding SelectionWarningColor}"
                               Style="{StaticResource SelectionWarningLabelStyle}"
                               IsVisible="{Binding HasSelectionWarning}" />
                    </Grid>
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
