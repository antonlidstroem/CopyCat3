<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CopyCat.ViewModels"
             xmlns:models="clr-namespace:CopyCat.Models"
             xmlns:behaviors="clr-namespace:CopyCat.Behaviors"
             x:Class="CopyCat.MainPage"
             x:DataType="vm:MainViewModel"
             x:Name="ThisPage"
             BackgroundColor="#070F12">

    <Grid RowDefinitions="*,Auto">

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 0 — SCROLLABLE CONTENT
             ═══════════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Padding="14,14,14,8" Spacing="0">

                <!-- ════════════════════════════════════════════════════
                     CONFIGURATION PANEL
                     ════════════════════════════════════════════════════ -->
                <VerticalStackLayout IsVisible="{Binding IsConfigurationMode}" Spacing="0">

                    <!-- ── MASTER CARD: URL + Branch + Token ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="REPOSITORY" Style="{StaticResource SectionTitle}" />

                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="GitHub URL or local path"
                                       Style="{StaticResource FieldLabel}" Margin="0" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="ⓘ" TextColor="{StaticResource AccentPrimary}"
                                       FontSize="16" VerticalOptions="Center"
                                       ToolTipProperties.Text="Paste a GitHub repo URL or a local folder path.">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowTokenInfoCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <!-- BUG G FIX: ColumnDefinitions="*,Auto,Auto", Entry at Column 0 -->
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Entry Grid.Column="0" Style="{StaticResource InputEntry}"
                                           Text="{Binding RepoUrl}"
                                           Placeholder="https://github.com/owner/repo  or  C:\Projects"
                                           Keyboard="Url" ReturnType="Next" Margin="4,0,0,0"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Text="✕"
                                            Command="{Binding ClearUrlCommand}" ToolTipProperties.Text="Clear URL"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Text="📋"
                                            Command="{Binding PasteUrlCommand}" ToolTipProperties.Text="Paste from clipboard"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                </Grid>
                            </Border>

                            <!-- Saved repos -->
                            <VerticalStackLayout IsVisible="{Binding HasSavedRepos}" Spacing="0">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                                    <Label Grid.Column="0" Text="Recent repositories"
                                           Style="{StaticResource FieldLabel}" Margin="0" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallIconBtn}" Text="✎  Rename"
                                            Command="{Binding RenameSelectedRepoCommand}"
                                            IsVisible="{Binding HasSelectedRepo}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                    <Button Grid.Column="2" Style="{StaticResource SmallIconBtn}" Text="✕"
                                            Command="{Binding ClearSelectedRepoCommand}"
                                            IsVisible="{Binding HasSelectedRepo}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                </Grid>
                                <Border Style="{StaticResource SavedReposListBorder}">
                                    <CollectionView ItemsSource="{Binding SavedRepos}" SelectionMode="None" MaximumHeightRequest="220">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SavedRepo">
                                                <Grid ColumnDefinitions="*,Auto" Padding="10,8">
                                                    <Label Grid.Column="0" Text="{Binding DisplayName}"
                                                           Style="{StaticResource SavedRepoRowLabel}" VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectRepoCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <Button Grid.Column="1" Style="{StaticResource SmallIconBtn}" Text="🗑"
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteRepoCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Border>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" Margin="0,4,0,10" />

                            <!-- Branch -->
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,4" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="Branch" Style="{StaticResource FieldLabel}" Margin="0" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center"
                                       ToolTipProperties.Text="Tap the field to open the branch picker." />
                            </Grid>
                            <Border Style="{StaticResource InputBorder}" Margin="0,0,0,6">
                                <Grid HeightRequest="50">
                                    <Grid IsVisible="{Binding IsFetchingBranches, Converter={StaticResource InverseBool}}" ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding BranchButtonLabel}"
                                               Style="{StaticResource BranchPickerLabel}" VerticalOptions="Center" Margin="12,0,0,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowBranchPickerCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Grid.Column="1" Text="⇅" TextColor="{StaticResource TextMuted}"
                                               FontSize="16" VerticalOptions="Center" Margin="0,0,12,0">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ShowBranchPickerCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShowBranchPickerCommand}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                    <HorizontalStackLayout IsVisible="{Binding IsFetchingBranches}"
                                                           HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                        <ActivityIndicator IsRunning="{Binding IsFetchingBranches}"
                                                           Color="{StaticResource AccentPrimary}"
                                                           HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                                        <Label Text="Loading branches…" TextColor="{StaticResource TextMuted}"
                                               FontSize="13" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>

                            <BoxView HeightRequest="1" Color="{StaticResource BorderDefault}" Margin="0,4,0,10" />

                            <!-- GitHub Token -->
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,4" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="GitHub Token (private repos)"
                                       Style="{StaticResource FieldLabel}" Margin="0" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="ⓘ" TextColor="{StaticResource AccentPrimary}"
                                       FontSize="16" VerticalOptions="Center" Margin="2,0,0,0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowTokenInfoCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Border Grid.Column="3" Style="{StaticResource SavedTokenBorder}" IsVisible="{Binding TokenIsSaved}">
                                    <Label Text="✓ Saved" TextColor="{StaticResource AccentSecond}" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource InputBorder}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0" Style="{StaticResource InputEntry}" Text="{Binding AccessToken}"
                                           Placeholder="ghp_… (leave empty for public repos)" IsPassword="True" ReturnType="Done"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Text="🗑"
                                            Command="{Binding ClearTokenCommand}" IsVisible="{Binding TokenIsSaved}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── FILE TYPES ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="FILE TYPES" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center"
                                           ToolTipProperties.Text="Enable the file extensions you want to include." />
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Style="{StaticResource AutoDetectBtn}" Text="🔍 Auto"
                                        Command="{Binding AutoDetectFileTypesCommand}"
                                        IsVisible="{Binding CanAutoDetect}"
                                        IsEnabled="{Binding IsAutoDetecting, Converter={StaticResource InverseBool}}" />
                                <Button Grid.Column="2" Style="{StaticResource ToggleAllBtn}" Text="Toggle all"
                                        Command="{Binding ToggleAllFileTypesCommand}"
                                        IsVisible="{Binding IsFileTypesExpanded}" />
                                <Label Grid.Column="3"
                                       Text="{Binding IsFileTypesExpanded, Converter={StaticResource ExpandArrowConv}}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFileTypesCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFileTypesCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <Label Text="{Binding FileTypeCardSummary}" Style="{StaticResource FileTypeSummaryLabel}"
                                   IsVisible="{Binding IsFileTypesExpanded, Converter={StaticResource InverseBool}}"
                                   Margin="0,6,0,0" />
                            <HorizontalStackLayout IsVisible="{Binding IsAutoDetecting}" Spacing="8" Margin="0,8,0,0">
                                <ActivityIndicator IsRunning="{Binding IsAutoDetecting}" Color="{StaticResource AccentSecond}"
                                                   HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                <Label Text="Detecting languages…" TextColor="{StaticResource TextMuted}"
                                       FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding AutoDetectStatusText}" Style="{StaticResource HintLabel}"
                                   IsVisible="{Binding HasAutoDetectStatus}" Margin="0,6,0,0" />
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                        IsVisible="{Binding IsFileTypesExpanded}" Margin="0,8,0,0">
                                <BindableLayout.ItemsSource>
                                    <Binding Path="FileTypeFilters" />
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileTypeFilter">
                                        <Border Style="{StaticResource ChipBorder}"
                                                BackgroundColor="{Binding IsEnabled, Converter={StaticResource ChipBgConv}}"
                                                Stroke="{Binding IsEnabled, Converter={StaticResource ChipBorderConv}}">
                                            <Label Text="{Binding Label}" Style="{StaticResource ChipLabel}"
                                                   TextColor="{Binding IsEnabled, Converter={StaticResource ChipLabelColorConv}}" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFileTypeCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── KEYWORD FILTER ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="KEYWORD FILTER" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="ⓘ" TextColor="{StaticResource AccentPrimary}"
                                       FontSize="16" VerticalOptions="Center" Margin="0,0,4,0"
                                       ToolTipProperties.Text="Only files whose content contains this exact term are included." />
                                <Label Grid.Column="2"
                                       Text="{Binding IsKeywordExpanded, Converter={StaticResource ExpandArrowConv}}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleKeywordCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleKeywordCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding IsKeywordExpanded}" Spacing="0">
                                <Label Text="Only files whose content contains this term will be included."
                                       Style="{StaticResource HintLabel}" />
                                <Border Style="{StaticResource InputBorder}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Entry Grid.Column="0" Style="{StaticResource InputEntry}"
                                               Text="{Binding KeywordFilter}" Placeholder="e.g. OrderService, IRepository…"
                                               ReturnType="Done"
                                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Text="✕"
                                                Command="{Binding ClearKeywordFilterCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── EXCLUDE FOLDERS ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="EXCLUDE FOLDERS" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center"
                                           ToolTipProperties.Text="Highlighted folders are excluded from the scan." />
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Style="{StaticResource ToggleAllBtn}" Text="Toggle all"
                                        Command="{Binding ToggleAllFolderFiltersCommand}" IsVisible="{Binding IsFoldersExpanded}" />
                                <Label Grid.Column="2"
                                       Text="{Binding IsFoldersExpanded, Converter={StaticResource ExpandArrowConv}}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFoldersCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFoldersCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" IsVisible="{Binding IsFoldersExpanded}">
                                <BindableLayout.ItemsSource><Binding Path="FolderFilters" /></BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FolderFilter">
                                        <Border Style="{StaticResource ChipBorder}"
                                                BackgroundColor="{Binding IsExcluded, Converter={StaticResource FolderChipBgConv}}"
                                                Stroke="{Binding IsExcluded, Converter={StaticResource FolderChipBorderConv}}">
                                            <Label Text="{Binding Name}" Style="{StaticResource ChipLabel}"
                                                   TextColor="{Binding IsExcluded, Converter={StaticResource ChipLabelColorConv}}" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFolderCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsFoldersExpanded}" Margin="0,6,0,0">
                                <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                    <Entry Style="{StaticResource InputEntry}" Text="{Binding CustomFolderInput}"
                                           Placeholder="Add folder name…" ReturnType="Done"
                                           ReturnCommand="{Binding AddCustomFolderCommand}"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource ToggleAllBtn}" Text="+ Add"
                                        Command="{Binding AddCustomFolderCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── EXCLUDE FILE PATTERNS ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="EXCLUDE FILE PATTERNS" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center"
                                           ToolTipProperties.Text="Glob patterns. Enabled = excluded." />
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Style="{StaticResource ToggleAllBtn}" Text="Toggle all"
                                        Command="{Binding ToggleAllFilePatternsCommand}" IsVisible="{Binding IsFilePatternsExpanded}" />
                                <Label Grid.Column="2"
                                       Text="{Binding IsFilePatternsExpanded, Converter={StaticResource ExpandArrowConv}}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFilePatternsCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFilePatternsCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <Label Text="Enabled patterns exclude matching files (e.g. *Test* removes all test files)."
                                   Style="{StaticResource HintLabel}" IsVisible="{Binding IsFilePatternsExpanded}" />
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" IsVisible="{Binding IsFilePatternsExpanded}">
                                <BindableLayout.ItemsSource><Binding Path="FilePatternFilters" /></BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FilePatternFilter">
                                        <Border Style="{StaticResource ChipBorder}"
                                                BackgroundColor="{Binding IsEnabled, Converter={StaticResource PatternChipBgConv}}"
                                                Stroke="{Binding IsEnabled, Converter={StaticResource PatternChipBorderConv}}">
                                            <Label Text="{Binding Pattern}" Style="{StaticResource ChipLabel}"
                                                   TextColor="{Binding IsEnabled, Converter={StaticResource ChipLabelColorConv}}" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleFilePatternCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsFilePatternsExpanded}" Margin="0,6,0,0">
                                <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                    <Entry Style="{StaticResource InputEntry}" Text="{Binding CustomPatternInput}"
                                           Placeholder="e.g. *Scaffold* or *.backup.*" ReturnType="Done"
                                           ReturnCommand="{Binding AddCustomPatternCommand}"
                                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource ToggleAllBtn}" Text="+ Add"
                                        Command="{Binding AddCustomPatternCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── TOKEN SLIDER ── -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="MAX TOKENS / CHUNK" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center"
                                           ToolTipProperties.Text="A token is roughly 4 characters of code." />
                                </HorizontalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource TokenBadgeBorder}">
                                    <Label Text="{Binding MaxTokensLabel}" Style="{StaticResource TokenBadgeLabel}" />
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,0,0,8">
                                <Button Grid.Column="0" Text="4K"    Style="{StaticResource SliderPresetBtn}" Command="{Binding SetPresetTokensCommand}" CommandParameter="4000" />
                                <Button Grid.Column="1" Text="8K"    Style="{StaticResource SliderPresetBtn}" Command="{Binding SetPresetTokensCommand}" CommandParameter="8000" />
                                <Button Grid.Column="2" Text="★ 16K" Style="{StaticResource SliderPresetBtn}" Command="{Binding SetPresetTokensCommand}" CommandParameter="16000" />
                                <Button Grid.Column="3" Text="32K"   Style="{StaticResource SliderPresetBtn}" Command="{Binding SetPresetTokensCommand}" CommandParameter="32000" />
                            </Grid>
                            <Label Text="{Binding SliderWarningText}" TextColor="{Binding SliderWarningColor}"
                                   Style="{StaticResource SliderWarningLabel}" />
                            <Slider Minimum="1000" Maximum="32000" Value="{Binding MaxTokensPerChunk}"
                                    MinimumTrackColor="{StaticResource SliderTrackActive}"
                                    MaximumTrackColor="{StaticResource SliderTrackInactive}"
                                    ThumbColor="{StaticResource SliderThumb}" HeightRequest="40"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Grid ColumnDefinitions="*,*">
                                <Label Grid.Column="0" Text="1 000" TextColor="{StaticResource TextDim}" FontSize="10" />
                                <Label Grid.Column="1" Text="32 000" TextColor="{StaticResource TextDim}" FontSize="10" HorizontalOptions="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ErrorBorder}" IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="⚠️" FontSize="18" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource ErrorLabel}" />
                        </Grid>
                    </Border>

                </VerticalStackLayout><!-- /Configuration panel -->

                <!-- ════════════════════════════════════════════════════
                     RESULTS PANEL
                     ════════════════════════════════════════════════════ -->
                <VerticalStackLayout IsVisible="{Binding IsResultsMode}" Spacing="0">

                    <VerticalStackLayout IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Spacing="10" Margin="0,0,0,10">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource ActivityIndicatorColor}"
                                           HeightRequest="36" WidthRequest="36" HorizontalOptions="Center" />
                        <Label Text="{Binding StatusText}" TextColor="{StaticResource TextSecondary}"
                               FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource ErrorBorder}" IsVisible="{Binding HasError}">
                        <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="⚠️" FontSize="18" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource ErrorLabel}" />
                        </Grid>
                    </Border>

                    <!-- Summary stats -->
                    <Border Style="{StaticResource SummaryBorder}" IsVisible="{Binding HasChunks}">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalFiles}"    Style="{StaticResource StatNumberLabel}" />
                                <Label Text="files"                   Style="{StaticResource StatCaptionLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalProjects}" Style="{StaticResource StatNumberLabel}" />
                                <Label Text="projects"                Style="{StaticResource StatCaptionLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding ChunkCount}"    Style="{StaticResource StatNumberLabel}" />
                                <Label Text="chunks"                  Style="{StaticResource StatCaptionLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                                <Label Text="{Binding TotalTokens}"   Style="{StaticResource StatNumberLabel}" />
                                <Label Text="tokens"                  Style="{StaticResource StatCaptionLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- ── AI PROMPTS (collapsible) ── -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasChunks}">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="AI PROMPTS" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                                    <Label Text="ⓘ" TextColor="{StaticResource AccentPrimary}" FontSize="16" VerticalOptions="Center"
                                           ToolTipProperties.Text="Tap a card to select it — it will be prepended when copying any chunk." />
                                </HorizontalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding IsPromptsExpanded, Converter={StaticResource ExpandArrowConv}}"
                                       TextColor="{StaticResource TextMuted}" FontSize="12" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePromptsCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePromptsCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <VerticalStackLayout IsVisible="{Binding IsPromptsExpanded}" Spacing="0">
                                <Label Text="Tap a card to select it for sharing. Use ▼ to preview the full prompt text."
                                       Style="{StaticResource HintLabel}" Margin="0,0,0,10" />
                                <CollectionView ItemsSource="{Binding Prompts}" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PromptItem">
                                            <Border Style="{StaticResource PromptCardBorder}"
                                                    BackgroundColor="{Binding CardBackgroundColor}"
                                                    Stroke="{Binding CardBorderColor}">
                                                <VerticalStackLayout Spacing="0">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                          ColumnSpacing="4" Padding="12,12,10,12"
                                                          IsVisible="{Binding IsEditing, Converter={StaticResource InverseBool}}">
                                                        <Border Grid.Column="0" Style="{StaticResource SelectionDot}"
                                                                BackgroundColor="{Binding IsSelectedForShare, Converter={StaticResource ShareSelectDotBgConv}}"
                                                                Stroke="{Binding IsSelectedForShare, Converter={StaticResource ShareSelectDotBorderConv}}">
                                                            <Label Style="{StaticResource SelectionDotCheck}" IsVisible="{Binding IsSelectedForShare}" />
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                            <Label Text="{Binding Title}" Style="{StaticResource PromptTitleLabel}" />
                                                            <VerticalStackLayout.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectPromptForShareCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                            </VerticalStackLayout.GestureRecognizers>
                                                        </VerticalStackLayout>
                                                        <Button Grid.Column="2" Style="{StaticResource SmallIconBtn}" Text="📋"
                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CopyPromptCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        <Button Grid.Column="3" Style="{StaticResource SmallIconBtn}" Text="✎"
                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.StartEditPromptCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        <Button Grid.Column="4" Style="{StaticResource SmallIconBtn}"
                                                                Text="{Binding PreviewToggleIcon}"
                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePromptPreviewCommand}"
                                                                CommandParameter="{Binding .}" />
                                                    </Grid>
                                                    <Border Style="{StaticResource PromptPreviewBorder}" IsVisible="{Binding IsPreviewExpanded}">
                                                        <VerticalStackLayout Spacing="6">
                                                            <Label Text="{Binding Content}" Style="{StaticResource PromptPreviewLabel}" LineBreakMode="WordWrap" />
                                                            <Button Style="{StaticResource PromptDeleteBtn}" Text="✕ Delete prompt"
                                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeletePromptCommand}"
                                                                    CommandParameter="{Binding .}"
                                                                    IsVisible="{Binding IsBuiltIn, Converter={StaticResource InverseBool}}"
                                                                    HorizontalOptions="End" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Style="{StaticResource PromptEditBorder}" IsVisible="{Binding IsEditing}">
                                                        <VerticalStackLayout Spacing="6">
                                                            <Label Text="Title" Style="{StaticResource FieldLabel}" />
                                                            <Border Style="{StaticResource InputBorder}">
                                                                <Entry Style="{StaticResource InputEntry}" Text="{Binding EditTitle}" Placeholder="Prompt title" />
                                                            </Border>
                                                            <Label Text="Prompt text" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                                                            <Border Style="{StaticResource InputBorder}">
                                                                <Editor Style="{StaticResource InlineEditor}" Text="{Binding EditContent}"
                                                                        Placeholder="Write your prompt… use [PASTE CHUNK] as a placeholder for the code." />
                                                            </Border>
                                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                                                <Label Grid.Column="0" Text="Use [PASTE CHUNK] to mark where the code goes."
                                                                       Style="{StaticResource HintLabel}" Margin="0" VerticalOptions="Center" />
                                                                <Button Grid.Column="2" Style="{StaticResource PromptSaveBtn}" Text="Save"
                                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SavePromptCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                                <Button Grid.Column="3" Style="{StaticResource SmallIconBtn}" Text="Cancel"
                                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CancelEditPromptCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                            </Grid>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Text="+ New prompt" Style="{StaticResource SecondaryBtn}" Command="{Binding AddNewPromptCommand}" />
                                    <Button Grid.Column="1" Text="↺ Reset" Style="{StaticResource ResetPromptsBtn}"
                                            x:Name="ResetPromptsButton"
                                            ToolTipProperties.Text="Delete all custom prompts and restore the 6 built-in defaults" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── CHUNK LIST ── -->
                    <VerticalStackLayout IsVisible="{Binding HasChunks}" Spacing="0">

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                            <Label Grid.Column="0" Text="CHUNKS" Style="{StaticResource SectionTitle}" Margin="0" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{Binding SelectAllChunksLabel}"
                                    Style="{StaticResource ToggleAllBtn}" Command="{Binding SelectAllChunksCommand}" />
                            <Label Grid.Column="2"
                                   Text="{Binding HasSelection, Converter={StaticResource SelectionHintConv}}"
                                   TextColor="{StaticResource TextMuted}" FontSize="11" VerticalOptions="Center" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding Chunks}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CodeChunk">
                                    <Border Style="{StaticResource ChunkBorder}"
                                            BackgroundColor="{Binding CardBackgroundColor}"
                                            Stroke="{Binding CardBorderColor}">
                                        <Border.Behaviors>
                                            <behaviors:TactileCopyBehavior />
                                        </Border.Behaviors>
                                        <VerticalStackLayout Spacing="0">

                                            <!-- MAIN ROW -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Padding="14,12">
                                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                        Style="{StaticResource SelectionDot}"
                                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectionDotBgConv}}"
                                                        Stroke="{Binding IsSelected, Converter={StaticResource SelectionDotBorderConv}}"
                                                        Margin="0,0,8,0">
                                                    <Label Style="{StaticResource SelectionDotCheck}" IsVisible="{Binding IsSelected}" />
                                                </Border>
                                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding DisplayLabel}" Style="{StaticResource ChunkTitleLabel}" />
                                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding SubLabel}"     Style="{StaticResource ChunkSubLabel}" />
                                                <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                                                                        Spacing="0" VerticalOptions="Center">
                                                    <Border Style="{StaticResource CopiedBadgeBorder}" IsVisible="{Binding IsCopied}" Margin="0,0,6,0">
                                                        <Label Style="{StaticResource CopiedBadgeLabel}" />
                                                    </Border>
                                                    <Button Text="Copy" MinimumWidthRequest="40"
                                                            Style="{StaticResource ChunkActionBtn}"
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CopyChunkCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ToolTipProperties.Text="Copy this chunk to clipboard" />
                                                    <Button Text="{Binding PreviewToggleIcon}" Style="{StaticResource SmallIconBtn}"
                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePreviewCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ToolTipProperties.Text="Show/hide files in this chunk" />
                                                </HorizontalStackLayout>
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleChunkSelectionCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>

                                            <!--
                                                ═══════════════════════════════════════════
                                                INTERACTIVE FILE LIST

                                                FIX 3: Binds to DisplayFiles (capped at 50)
                                                instead of Files. A footer label shows how
                                                many files are hidden when the cap is hit —
                                                prevents BindableLayout from rendering 100+
                                                rows at a very small token limit.
                                                ═══════════════════════════════════════════
                                            -->
                                            <Border Style="{StaticResource PreviewBorder}" IsVisible="{Binding IsPreviewExpanded}">
                                                <VerticalStackLayout Spacing="0">

                                                    <!-- Header: file count + All / None buttons -->
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
                                                        <Label Grid.Column="0" Text="{Binding IncludedFileCountLabel}"
                                                               TextColor="{StaticResource TextMuted}" FontSize="11" VerticalOptions="Center" />
                                                        <Button Grid.Column="1" Style="{StaticResource SmallToggleChunkFilesBtn}" Text="All"
                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectAllChunkFilesCommand}"
                                                                CommandParameter="{Binding .}"
                                                                ToolTipProperties.Text="Include all files in this chunk" />
                                                        <Button Grid.Column="2" Style="{StaticResource SmallToggleChunkFilesBtn}" Text="None"
                                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeselectAllChunkFilesCommand}"
                                                                CommandParameter="{Binding .}"
                                                                ToolTipProperties.Text="Exclude all files from this chunk" />
                                                    </Grid>

                                                    <!-- File rows (capped at 50) -->
                                                    <VerticalStackLayout Spacing="0">
                                                        <BindableLayout.ItemsSource>
                                                            <Binding Path="DisplayFiles" />
                                                        </BindableLayout.ItemsSource>
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:CodeChunkFile">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,5,0,5">
                                                                    <!--
                                                                        Teal inclusion dot — distinct from the amber chunk-selection dot.
                                                                        Uses ChunkFileDotBgConv / ChunkFileDotBorderConv.
                                                                    -->
                                                                    <Border Grid.Column="0" Style="{StaticResource SelectionDot}"
                                                                            BackgroundColor="{Binding IsIncluded, Converter={StaticResource ChunkFileDotBgConv}}"
                                                                            Stroke="{Binding IsIncluded, Converter={StaticResource ChunkFileDotBorderConv}}"
                                                                            Margin="0">
                                                                        <Label Style="{StaticResource SelectionDotCheck}" IsVisible="{Binding IsIncluded}" />
                                                                    </Border>
                                                                    <!-- File name: bright / strikethrough based on IsIncluded -->
                                                                    <Label Grid.Column="1" Text="{Binding FileName}"
                                                                           TextColor="{Binding IsIncluded, Converter={StaticResource ChunkFileLabelColorConv}}"
                                                                           TextDecorations="{Binding IsIncluded, Converter={StaticResource ChunkFileDecorationConv}}"
                                                                           FontSize="12"
                                                                           FontFamily="Courier New, Courier, monospace"
                                                                           LineBreakMode="TailTruncation"
                                                                           VerticalOptions="Center" />
                                                                    <!-- Token count -->
                                                                    <Label Grid.Column="2"
                                                                           Text="{Binding EstimatedTokens, StringFormat='~{0:N0} tok'}"
                                                                           Style="{StaticResource ChunkFileTokenLabel}" />
                                                                    <Grid.GestureRecognizers>
                                                                        <TapGestureRecognizer
                                                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleChunkFileCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                    </Grid.GestureRecognizers>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>

                                                    <!--
                                                        FIX 3: Footer shown when > 50 files exist in the chunk.
                                                        Tells the user how many rows are not rendered, and why.
                                                        Visible only when HiddenFileCount > 0 (IntGtZero converter).
                                                    -->
                                                    <Label IsVisible="{Binding HiddenFileCount, Converter={StaticResource IntGtZero}}"
                                                           TextColor="{StaticResource TextDim}"
                                                           FontSize="11"
                                                           Margin="0,6,0,0">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="… and " />
                                                                <Span Text="{Binding HiddenFileCount}" FontAttributes="Bold" />
                                                                <Span Text=" more files (increase token limit to reduce chunk size)" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>

                                                </VerticalStackLayout>
                                            </Border>

                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout><!-- /Chunk list -->

                </VerticalStackLayout><!-- /Results panel -->

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════════════════════════════
             ROW 1 — SMART ACTION BAR
             BUG A FIX: three rows so the selection toolbar never overlaps
             the busy spinner row.
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource SmartActionBarBorder}" Padding="16,0,16,50">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

                <!-- Row 0: Busy indicator + Abort -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsBusy}">
                    <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsBusy}"
                                       Color="{StaticResource AccentPrimary}"
                                       HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding StatusText}" TextColor="{StaticResource TextSecondary}"
                           FontSize="13" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                    <Button Grid.Column="2" Text="Abort" Style="{StaticResource SecondaryBtn}"
                            FontSize="13" MinimumHeightRequest="40" Command="{Binding CancelCommand}" />
                </Grid>

                <!-- Row 1: Chunk button (config) or Reset + Edit Config (results) -->
                <Button Grid.Row="1" ImageSource="copycat_logo.svg"
                        Style="{StaticResource PrimaryBtn}" HeightRequest="90" ContentLayout="Top,0"
                        Command="{Binding FetchCommand}"
                        IsVisible="{Binding IsConfigurationMode}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsResultsMode}">
                    <Button Grid.Column="0" Text="🔄  Reset" Style="{StaticResource SecondaryBtn}"
                            Command="{Binding ResetCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <Button Grid.Column="1" Text="⚙  Edit Config" Style="{StaticResource BackBtn}"
                            Command="{Binding BackToConfigurationCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </Grid>

                <!-- Row 2: Multi-select toolbar — own row, no layout overlap -->
                <Border Grid.Row="2" Style="{StaticResource SelectionToolbarBorder}" IsVisible="{Binding HasSelection}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                            <Label Text="{Binding ShareSelectedLabel}" Style="{StaticResource SelectionCountLabel}" />
                            <Label Text="{Binding SelectedTokensLabel}" Style="{StaticResource SelectionTokensLabel}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="✕" Style="{StaticResource IconBtn}"
                                Command="{Binding ClearSelectionCommand}" ToolTipProperties.Text="Deselect all" />
                        <Button Grid.Column="2" Text="📋 Copy" Style="{StaticResource CopySelectedBtn}"
                                Command="{Binding CopySelectedCommand}"
                                ToolTipProperties.Text="Copy all selected chunks to clipboard" />
                        <Button Grid.Column="3" Text="↗ Share" Style="{StaticResource ShareBtn}"
                                Command="{Binding ShareSelectedCommand}"
                                ToolTipProperties.Text="Share all selected chunks via the system share sheet" />
                    </Grid>
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentPage>
